actions.precombat+=/defensive_stance,line_cd=4
actions.precombat+=/battle_shout

actions+=/spell_reflection,if=!prev.1.pummel
actions+=/pummel,if=!prev.1.spell_reflection
actions+=/shield_block,if=buff.shield_block.remains<=4
actions+=/tank_combat_wait,if=time<combat_delay&moving
actions+=/tank_combat_wait,if=time<combat_delay&time<combat_delay/2&moving
#self
actions+=/thunderous_roar,if=fight_remains>25&time>5|active_enemies>5&fight_remains>10
actions+=/avatar,if=fight_remains>25&(buff.thunder_blast.down|!talent.avatar_of_the_storm|buff.thunder_blast.stack<=1&cooldown.thunder_blast.remains>=2)
actions+=/shield_wall,use_off_gcd=1,if=tanking&incoming_damage_5s>shield_wall_damage_taken&health.pct<=shield_wall_health_pct&!(buff.shield_wall.up|buff.last_stand.up|buff.rallying_cry.up|buff.potion.up)
#actions+=/ignore_pain,if=(rage.deficit<=15&cooldown.shield_slam.ready|rage.deficit<=40&cooldown.shield_charge.ready&talent.champions_bulwark.enabled|rage.deficit<=20&cooldown.shield_charge.ready|rage.deficit<=30&cooldown.demoralizing_shout.ready&talent.booming_voice.enabled|rage.deficit<=20&cooldown.avatar.ready|rage.deficit<=45&cooldown.demoralizing_shout.ready&talent.booming_voice.enabled&buff.last_stand.up&talent.unnerving_focus.enabled|rage.deficit<=30&cooldown.avatar.ready&buff.last_stand.up&talent.unnerving_focus.enabled|rage.deficit<=20|rage.deficit<=40&cooldown.shield_slam.ready&buff.violent_outburst.up&talent.heavy_repercussions.enabled&talent.impenetrable_wall.enabled|rage.deficit<=55&cooldown.shield_slam.ready&buff.violent_outburst.up&buff.last_stand.up&talent.unnerving_focus.enabled&talent.heavy_repercussions.enabled&talent.impenetrable_wall.enabled|rage.deficit<=17&cooldown.shield_slam.ready&talent.heavy_repercussions.enabled|rage.deficit<=18&cooldown.shield_slam.ready&talent.impenetrable_wall.enabled)|(rage>=70|buff.seeing_red.stack=7&rage>=35)&cooldown.shield_slam.remains<=1&buff.shield_block.remains>=4&set_bonus.tier31_2pc,use_off_gcd=1
#self
actions+=/ignore_pain,if=buff.ignore_pain.remains<2&buff.shield_block.up|buff.ignore_pain.v1<=health.max*0.2&buff.shield_block.up&time>8
actions+=/last_stand,use_off_gcd=1,if=tanking&incoming_damage_5s>last_stand_damage_taken&health.pct<=last_stand_health_pct&!(buff.shield_wall.up|buff.last_stand.up|buff.rallying_cry.up|buff.potion.up)
actions+=/rallying_cry,if=tanking&incoming_damage_5s>rallying_cry_damage_taken&health.pct<=rallying_cry_health_pct&!(buff.shield_wall.up|buff.last_stand.up|buff.rallying_cry.up|buff.potion.up)
actions+=/victory_rush,if=health.pct<victory_rush_health_pct&talent.impending_victory.disabled&(time>10|active_enemies<2)
actions+=/impending_victory,if=health.pct<victory_rush_health_pct&talent.impending_victory.enabled&(time>10|active_enemies<2)
actions+=/blood_fury
actions+=/berserking
actions+=/arcane_torrent
actions+=/lights_judgment
actions+=/fireblood
actions+=/ancestral_call
actions+=/bag_of_tricks
actions+=/potion,if=buff.avatar.up&fight_remains>40
actions+=/use_items,if=buff.avatar.remains>10&!trinket.t1.is.chaotic_nethergate&!trinket.1.is.chromebustible_bomb_suit&!trinket.1.is.ringing_ritual_mud&!trinket.1.is.tome_of_lights_devotion_443535&!trinket.2.is.chromebustible_bomb_suit&!trinket.2.is.ringing_ritual_mud&!trinket.2.is.tome_of_lights_devotion_443535&!trinket.t2.is.chaotic_nethergate
actions+=/chaotic_nethergate,enabled=0,if=active_enemies>=5&fight_remains>20&time>5
actions+=/thunder_blast,if=spell_targets.thunder_blast>=2&buff.thunder_blast.stack=2
actions+=/shield_charge,if=cooldown.avatar.remains>10&fight_remains>15&time>5
actions+=/ravager,if=fight_remains>35&(active_enemies>=3|boss)
actions+=/demoralizing_shout,if=time>combat_delay&(talent.snap_induction&buff.thunder_blast.stack<2|!talent.snap_induction)
actions+=/champions_spear
actions+=/demolish,if=buff.colossal_might.stack>=3&cooldown.avatar.remains>10&fight_remains>10

actions+=/run_action_list,name=mountain_aoe,strict=1,if=active_enemies>=3&hero_tree.mountain_thane
actions+=/run_action_list,name=mountain_generic,if=active_enemies<3&hero_tree.mountain_thane

actions+=/run_action_list,name=colossus_aoe,strict=1,if=active_enemies>=3&!hero_tree.mountain_thane
actions+=/run_action_list,name=colossus_generic,if=active_enemies<3&!hero_tree.mountain_thane

#self
actions.mountain_aoe+=/thunder_blast,if=buff.thunder_blast.stack=2
#self
actions.mountain_aoe+=/shield_slam,if=buff.burst_of_power.stack>=2&rage<100
#self
actions.mountain_aoe+=/execute,if=spell_targets.execute>=2&(rage>=50|buff.sudden_death.up)&talent.heavy_handed.enabled&(buff.ignore_pain.remains>3&buff.shield_block.remains>2|rage>=75)&time>10
actions.mountain_aoe+=/thunder_blast,if=dot.rend.remains<=1
actions.mountain_aoe+=/thunder_clap,if=dot.rend.remains<=1
actions.mountain_aoe+=/thunder_blast,if=buff.violent_outburst.up&spell_targets.thunderclap>=2&buff.avatar.up&talent.unstoppable_force.enabled
#self
actions.mountain_aoe+=/thunder_blast,if=buff.thunder_blast.up
#self
actions.mountain_aoe+=/shield_slam,if=buff.thunder_blast.stack<2&rage<=100
#self
actions.mountain_aoe+=/shield_slam,if=rage<=100|cooldown.shield_slam.charges>1|buff.violent_outburst.up&spell_targets.thunderclap<=4&talent.crashing_thunder.enabled
actions.mountain_aoe+=/revenge,if=buff.revenge.up
actions.mountain_aoe+=/revenge,if=rage>=40&target.health.pct>=25&(buff.ignore_pain.remains>3&buff.shield_block.remains>2|rage>=75)|rage>=40&!talent.heavy_handed
actions.mountain_aoe+=/thunder_clap,if=buff.violent_outburst.up&spell_targets.thunderclap>=4&buff.avatar.up&talent.unstoppable_force.enabled&talent.crashing_thunder.enabled|buff.violent_outburst.up&spell_targets.thunderclap>6&buff.avatar.up&talent.unstoppable_force.enabled
actions.mountain_aoe+=/thunder_blast
actions.mountain_aoe+=/thunder_clap
#self
actions.mountain_aoe+=/execute,if=spell_targets.execute>=2&(rage>=50|buff.sudden_death.up)&talent.sudden_death.enabled&(buff.ignore_pain.remains>3&buff.shield_block.remains>2|rage>=75)

#self
actions.mountain_generic+=/thunder_blast,if=buff.thunder_blast.stack=2
#self
actions.mountain_generic+=/shield_slam,if=buff.burst_of_power.stack>=2&rage<100
#self
actions.mountain_generic+=/execute,if=(rage>=50|buff.sudden_death.up)&(buff.ignore_pain.remains>3&buff.shield_block.remains>2|rage>=75)
actions.mountain_generic+=/thunder_blast,if=dot.rend.remains<=1
actions.mountain_generic+=/thunder_clap,if=dot.rend.remains<=1
actions.mountain_generic+=/thunder_blast,if=buff.violent_outburst.up&spell_targets.thunderclap>=2&buff.avatar.up&talent.unstoppable_force.enabled
#self
actions.mountain_generic+=/thunder_blast,if=buff.thunder_blast.up
#self
actions.mountain_generic+=/shield_slam,if=buff.thunder_blast.down&rage<=100&talent.lightning_strikes
actions.mountain_generic+=/thunder_clap,if=buff.violent_outburst.up&spell_targets.thunderclap>=4&buff.avatar.up&talent.unstoppable_force.enabled&talent.crashing_thunder.enabled|buff.violent_outburst.up&spell_targets.thunderclap>6&buff.avatar.up&talent.unstoppable_force.enabled
#self
actions.mountain_generic+=/shield_slam,if=rage<=90|cooldown.shield_slam.charges>1|buff.violent_outburst.up&spell_targets.thunderclap<=4&talent.crashing_thunder.enabled
actions.mountain_generic+=/revenge,if=buff.revenge.up
actions.mountain_generic+=/thunder_blast
actions.mountain_generic+=/thunder_clap
actions.mountain_generic+=/revenge,if=rage>=40&target.health.pct>=25&(buff.ignore_pain.remains>3&buff.shield_block.remains>2|rage>=75)
actions.mountain_generic+=/devastate


actions.colossus_aoe+=/thunder_blast,if=dot.rend.remains<=1
actions.colossus_aoe+=/thunder_clap,if=dot.rend.remains<=1
actions.colossus_aoe+=/thunder_blast,if=buff.violent_outburst.up&active_enemies>=2&buff.avatar.up&talent.unstoppable_force.enabled
actions.colossus_aoe+=/execute,if=spell_targets.execute>=2&(rage>=50|buff.sudden_death.up)&talent.heavy_handed.enabled
actions.colossus_aoe+=/thunder_clap,if=buff.violent_outburst.up&active_enemies>=4&buff.avatar.up&talent.unstoppable_force.enabled&talent.crashing_thunder.enabled|buff.violent_outburst.up&active_enemies>6&buff.avatar.up&talent.unstoppable_force.enabled
actions.colossus_aoe+=/revenge,if=rage>=70&talent.seismic_reverberation.enabled&active_enemies>=3
actions.colossus_aoe+=/shield_slam,if=rage<=60|buff.violent_outburst.up&active_enemies<=4&talent.crashing_thunder.enabled
actions.colossus_aoe+=/thunder_blast
actions.colossus_aoe+=/thunder_clap
actions.colossus_aoe+=/revenge,if=rage>=30|rage>=40&talent.barbaric_training.enabled

actions.colossus_generic+=/thunder_blast,if=(buff.thunder_blast.stack=2&buff.burst_of_power.stack<=1&buff.avatar.up&talent.unstoppable_force.enabled)
actions.colossus_generic+=/shield_slam,if=(buff.burst_of_power.stack=2&buff.thunder_blast.stack<=1|buff.violent_outburst.up)|rage<=70&talent.demolish.enabled
actions.colossus_generic+=/execute,if=rage>=70|(rage>=40&cooldown.shield_slam.remains&talent.demolish.enabled|rage>=50&cooldown.shield_slam.remains)|buff.sudden_death.up&talent.sudden_death.enabled
actions.colossus_generic+=/shield_slam
actions.colossus_generic+=/thunder_blast,if=dot.rend.remains<=2&buff.violent_outburst.down
actions.colossus_generic+=/thunder_blast
actions.colossus_generic+=/thunder_clap,if=dot.rend.remains<=2&buff.violent_outburst.down
actions.colossus_generic+=/thunder_blast,if=(active_enemies>1|cooldown.shield_slam.remains&!buff.violent_outburst.up)
actions.colossus_generic+=/thunder_clap,if=(active_enemies>1|cooldown.shield_slam.remains&!buff.violent_outburst.up)
actions.colossus_generic+=/revenge,if=(rage>=80&target.health.pct>20|buff.revenge.up&target.health.pct<=20&rage<=18&cooldown.shield_slam.remains|buff.revenge.up&target.health.pct>20)|(rage>=80&target.health.pct>35|buff.revenge.up&target.health.pct<=35&rage<=18&cooldown.shield_slam.remains|buff.revenge.up&target.health.pct>35)&talent.massacre.enabled
actions.colossus_generic+=/execute
actions.colossus_generic+=/revenge
actions.colossus_generic+=/thunder_blast,if=(active_enemies>=1|cooldown.shield_slam.remains&buff.violent_outburst.up)
actions.colossus_generic+=/thunder_clap,if=(active_enemies>=1|cooldown.shield_slam.remains&buff.violent_outburst.up)
actions.colossus_generic+=/devastate
