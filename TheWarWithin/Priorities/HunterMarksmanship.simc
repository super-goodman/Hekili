actions.precombat+=/summon_pet,if=talent.unbreakable_bond
actions.precombat+=/variable,name=trinket_1_stronger,value=!trinket.2.has_cooldown|trinket.1.has_use_buff&(!trinket.2.has_use_buff|!trinket.1.is.mirror_of_fractured_tomorrows&(trinket.2.is.mirror_of_fractured_tomorrows|trinket.2.cooldown.duration<trinket.1.cooldown.duration|trinket.2.cast_time<trinket.1.cast_time|trinket.2.cast_time=trinket.1.cast_time&trinket.2.cooldown.duration=trinket.1.cooldown.duration))|!trinket.1.has_use_buff&(!trinket.2.has_use_buff&(trinket.2.cooldown.duration<trinket.1.cooldown.duration|trinket.2.cast_time<trinket.1.cast_time|trinket.2.cast_time=trinket.1.cast_time&trinket.2.cooldown.duration=trinket.1.cooldown.duration))
actions.precombat+=/variable,name=trinket_2_stronger,value=!variable.trinket_1_stronger
actions.precombat+=/hunters_mark,if=(settings.mark_any|target.is_boss)&active_dot.hunters_mark=0&target.time_to_pct_80>20

actions+=/feign_death_wait,if=buff.feign_death.up
actions+=/counter_shot
actions+=/tranquilizing_shot
actions+=/call_action_list,name=mitigation,strict=1,if=!Pvepvp_check&!raid
actions+=/variable,name=trueshot_ready,value=cooldown.trueshot.ready&((!raid_event.adds.exists|raid_event.adds.count=1)&(!talent.bullseye|fight_remains>cooldown.trueshot.duration_guess+buff.trueshot.duration%2|buff.bullseye.stack=buff.bullseye.max_stack)&(!trinket.1.has_use_buff|trinket.1.cooldown.remains>30|trinket.1.cooldown.ready)&(!trinket.2.has_use_buff|trinket.2.cooldown.remains>30|trinket.2.cooldown.ready)|raid_event.adds.exists&(!raid_event.adds.up&(raid_event.adds.duration+raid_event.adds.in<25|raid_event.adds.in>60)|raid_event.adds.up&raid_event.adds.remains>10)|boss&fight_remains<25)
actions+=/mend_pet,if=pet.health_pct<pet_healing
actions+=/hunters_mark,if=(settings.mark_any|target.is_boss)&active_dot.hunters_mark=0&target.time_to_pct_80>20
actions+=/call_action_list,name=move_trickshots,strict=1,if=movement.distance>=1&active_enemies>=3&talent.trick_shots
actions+=/call_action_list,name=move_cleave,strict=1,if=movement.distance>=1&active_enemies=2
actions+=/call_action_list,name=move_st,strict=1,if=!talent.black_arrow&movement.distance>=1&(active_enemies<2|!talent.trick_shots)
actions+=/call_action_list,name=move_st_dark,strict=1,if=talent.black_arrow&movement.distance>=1&(active_enemies<2|!talent.trick_shots)

actions+=/call_action_list,name=trickshots,strict=1,if=!moving&(active_enemies=3&!target.moving|active_enemies>3)&talent.trick_shots&hero_tree.sentinel&cooldown_check
actions+=/call_action_list,name=trickshots_dark,strict=1,if=active_enemies>=3&talent.trick_shots&hero_tree.dark_ranger
actions+=/call_action_list,name=cleave,strict=1,if=active_enemies=2
actions+=/call_action_list,name=st_dark,strict=1,if=talent.black_arrow&(active_enemies<2|!talent.trick_shots)&!moving
actions+=/call_action_list,name=st,strict=1,if=!talent.black_arrow&(active_enemies<2|!talent.trick_shots)&!moving

## self
actions+=/call_action_list,name=st,strict=1,if=active_enemies=3&target.moving&talent.trick_shots&moving

actions.cds+=/berserking,if=buff.trueshot.up|boss&fight_remains<13&raid
actions.cds+=/blood_fury,if=buff.trueshot.up|cooldown.trueshot.remains>30|boss&fight_remains<16&raid
actions.cds+=/ancestral_call,if=buff.trueshot.up|cooldown.trueshot.remains>30|boss&fight_remains<16&raid
actions.cds+=/fireblood,if=buff.trueshot.up|cooldown.trueshot.remains>30|boss&fight_remains<9&raid
actions.cds+=/lights_judgment,if=buff.trueshot.down
actions.cds+=/potion,if=buff.trueshot.up&(buff.bloodlust.up|target.health.pct<20)|boss&fight_remains<31&raid


# ################# 2 targets (2+ without Trick Shots)
## [Syrif] - prev.1.aimed_shot is more stable for this interaction than action.aimed_shot.in_flight
## actions.cleave=explosive_shot,if=talent.precision_detonation&action.aimed_shot.in_flight&(buff.trueshot.down|!talent.windrunner_quiver)
actions.cleave+=/explosive_shot,if=talent.precision_detonation&prev.1.aimed_shot&(buff.trueshot.down|!talent.windrunner_quiver)
actions.cleave+=/black_arrow,if=buff.precise_shots.up&buff.moving_target.down&variable.trueshot_ready
actions.cleave+=/volley,if=(talent.double_tap&buff.double_tap.down|!talent.aspect_of_the_hydra)&(buff.precise_shots.down|buff.moving_target.up)&(fight_remains>20|raid&boss)
actions.cleave+=/rapid_fire,if=talent.bulletstorm&buff.bulletstorm.down&(!talent.double_tap|buff.double_tap.up|!talent.aspect_of_the_hydra&buff.trick_shots.remains>execute_time)&(buff.precise_shots.down|buff.moving_target.up|!talent.volley)
actions.cleave+=/volley,if=!talent.double_tap&(buff.precise_shots.down|buff.moving_target.up)
## [Syrif] - Using buff.lunar_storm_cooldown.up works better because we can just ask the API without any trickery.
## actions.cleave+=/trueshot,if=variable.trueshot_ready&(buff.double_tap.down|!talent.volley)&(buff.lunar_storm_ready.down|!talent.double_tap|!talent.volley)&(buff.precise_shots.down|buff.moving_target.up|!talent.volley)
actions.cleave+=/trueshot,if=variable.trueshot_ready&(buff.double_tap.down|!talent.volley)&(buff.lunar_storm_cooldown.up|!talent.double_tap|!talent.volley)&(buff.precise_shots.down|buff.moving_target.up|!talent.volley)
# Queue Steady Shot after Aimed Shot if a Deathblow hasn't already been up long enough to be reacted to. Sentinel only seems to like this due to the Precise Shots gcd bug.
## [Syrif] - The bug is fixed, also again, prev.1 more stable
## actions.cleave+=/steady_shot,if=(talent.black_arrow|bugs)&focus+cast_regen<focus.max&action.aimed_shot.in_flight&!buff.deathblow.react&buff.trueshot.down&cooldown.trueshot.remains
actions.cleave+=/steady_shot,if=talent.black_arrow&focus+cast_regen<focus.max&prev.1.aimed_shot&!buff.deathblow.react&buff.trueshot.down&cooldown.trueshot.remains
actions.cleave+=/rapid_fire,if=talent.lunar_storm&buff.lunar_storm_cooldown.down&(buff.precise_shots.down|buff.moving_target.up|cooldown.volley.remains&cooldown.trueshot.remains|!talent.volley)
actions.cleave+=/kill_shot,cycle_targets=1,if=talent.headshot&buff.precise_shots.up&(debuff.spotters_mark.down|buff.moving_target.down)|!talent.headshot&buff.razor_fragments.up
actions.cleave+=/black_arrow,if=talent.headshot&buff.precise_shots.up&(debuff.spotters_mark.down|buff.moving_target.down)|!talent.headshot&buff.razor_fragments.up
actions.cleave+=/multishot,cycle_targets=1,if=buff.precise_shots.up&(debuff.spotters_mark.down|buff.moving_target.down)&!talent.aspect_of_the_hydra&(talent.symphonic_arsenal|talent.small_game_hunter)
actions.cleave+=/arcane_shot,cycle_targets=1,if=buff.precise_shots.up&(debuff.spotters_mark.down|buff.moving_target.down)
# Prioritize Aimed Shot a little higher when close to capping charges.
actions.cleave+=/aimed_shot,cycle_targets=1,if=(buff.precise_shots.down|debuff.spotters_mark.up&buff.moving_target.up)&full_recharge_time<action.rapid_fire.execute_time+cast_time&(!talent.bulletstorm|buff.bulletstorm.up)&talent.windrunner_quiver
actions.cleave+=/rapid_fire,if=!talent.bulletstorm|buff.bulletstorm.stack<=10|talent.aspect_of_the_hydra
actions.cleave+=/aimed_shot,cycle_targets=1,if=buff.precise_shots.down|debuff.spotters_mark.up&buff.moving_target.up
actions.cleave+=/rapid_fire
actions.cleave+=/explosive_shot,if=(talent.precision_detonation|buff.trueshot.down)&buff.lock_and_load.down
actions.cleave+=/black_arrow,if=!talent.headshot
actions.cleave+=/steady_shot

# ########## 1 target
## [Syrif] This whole list depends on talent.black_arrow, so some below are removed
## [Syrif] - prev.1 more stable
## actions.st_dark+=/explosive_shot,if=talent.precision_detonation&action.aimed_shot.in_flight&buff.trueshot.down&buff.lock_and_load.down
actions.st_dark+=/explosive_shot,if=talent.precision_detonation&prev.1.aimed_shot&buff.trueshot.down&buff.lock_and_load.down
actions.st_dark+=/volley,if=buff.double_tap.down&(!raid_event.adds.exists|raid_event.adds.in>cooldown)
## [Syrif] - The bug is fixed, also again, prev.1 more stable
## actions.st_dark+=/steady_shot,if=(talent.black_arrow|bugs)&focus+cast_regen<focus.max&action.aimed_shot.in_flight&(!action.black_arrow.cooldown_react)&buff.trueshot.down&cooldown.trueshot.remains
actions.st_dark+=/steady_shot,if=focus+cast_regen<focus.max&prev.1.aimed_shot&(!cooldown.black_arrow.ready)&buff.trueshot.down&cooldown.trueshot.remains
actions.st_dark+=/black_arrow,if=!talent.headshot|talent.headshot&buff.precise_shots.up&(debuff.spotters_mark.down|buff.moving_target.down)
actions.st_dark+=/aimed_shot,if=buff.trueshot.up&buff.precise_shots.down|buff.lock_and_load.up&buff.moving_target.up
actions.st_dark+=/rapid_fire,if=!buff.deathblow.up
actions.st_dark+=/call_action_list,strict=1,name=cds
actions.st_dark+=/call_action_list,strict=1,name=trinkets
actions.st_dark+=/trueshot,if=variable.trueshot_ready&buff.double_tap.down&buff.deathblow.down
actions.st_dark+=/arcane_shot,if=buff.precise_shots.up&(debuff.spotters_mark.down|buff.moving_target.down)
actions.st_dark+=/aimed_shot,if=buff.precise_shots.down|debuff.spotters_mark.up&buff.moving_target.up
actions.st_dark+=/explosive_shot,if=talent.shrapnel_shot&buff.lock_and_load.down
actions.st_dark+=/steady_shot

actions.st+=/explosive_shot,if=talent.precision_detonation&action.aimed_shot.in_flight&buff.trueshot.down
actions.st+=/volley,if=buff.double_tap.down&(!raid_event.adds.exists|raid_event.adds.in>cooldown)
actions.st+=/call_action_list,strict=1,name=cds
actions.st+=/call_action_list,strict=1,name=trinkets
actions.st+=/trueshot,if=variable.trueshot_ready&buff.double_tap.down
# Queue Steady Shot after Aimed Shot if a Deathblow hasn't already been up long enough to be reacted to. Sentinel only seems to like this due to the Precise Shots gcd bug.
## [Syrif] - The bug is fixed, this entry can never pass now, I expect SimC to remove it soon
## actions.st+=/steady_shot,if=(talent.black_arrow|bugs)&focus+cast_regen<focus.max&action.aimed_shot.in_flight&!buff.deathblow.react&buff.trueshot.down&cooldown.trueshot.remains
actions.st+=/rapid_fire,if=talent.lunar_storm&buff.lunar_storm_cooldown.down
actions.st+=/kill_shot,if=talent.headshot&buff.precise_shots.up&(debuff.spotters_mark.down|buff.moving_target.down)|!talent.headshot&buff.razor_fragments.up
actions.st+=/arcane_shot,if=buff.precise_shots.up&(debuff.spotters_mark.down|buff.moving_target.down)
# Prioritize Aimed Shot a little higher when close to capping charges.
actions.st+=/aimed_shot,if=(buff.precise_shots.down|debuff.spotters_mark.up&buff.moving_target.up)&full_recharge_time<action.rapid_fire.execute_time+cast_time&(!talent.bulletstorm|buff.bulletstorm.up)&talent.windrunner_quiver
actions.st+=/rapid_fire
actions.st+=/aimed_shot,if=buff.precise_shots.down|debuff.spotters_mark.up&buff.moving_target.up
actions.st+=/explosive_shot,if=talent.precision_detonation|buff.trueshot.down
actions.st+=/steady_shot

# ################ 3+ targets (with Trick Shots)
actions.trickshots_dark+=/explosive_shot,if=talent.precision_detonation&prev.1.aimed_shot&buff.trueshot.down&(!talent.shrapnel_shot|buff.lock_and_load.down)
actions.trickshots_dark+=/volley,if=buff.double_tap.down&(!talent.shrapnel_shot|buff.lock_and_load.down)
actions.trickshots_dark+=/rapid_fire,if=talent.bulletstorm&buff.bulletstorm.down&buff.trick_shots.remains>execute_time
actions.trickshots_dark+=/rapid_fire,if=hero_tree.sentinel&buff.lunar_storm_cooldown.down&buff.trick_shots.remains>execute_time
# Queue Steady Shot after Aimed Shot if a Deathblow hasn't already been up long enough to be reacted to.
actions.trickshots_dark+=/steady_shot,if=talent.black_arrow&focus+cast_regen<focus.max&prev.1.aimed_shot&!buff.deathblow.react&buff.trueshot.down&cooldown.trueshot.remains
actions.trickshots_dark+=/black_arrow,if=buff.trick_shots.up
# Retarget to possibly spread an extra Spotter's Mark if able.
actions.trickshots_dark+=/multishot,cycle_targets=1,if=buff.precise_shots.up&buff.moving_target.down|buff.trick_shots.down
actions.trickshots_dark+=/call_action_list,strict=1,name=cds
actions.trickshots_dark+=/call_action_list,strict=1,name=trinkets
actions.trickshots_dark+=/trueshot,if=variable.trueshot_ready&buff.double_tap.down
actions.trickshots_dark+=/volley,if=buff.double_tap.down&(!talent.salvo|!talent.precision_detonation|(buff.precise_shots.down|debuff.spotters_mark.up&buff.moving_target.up))&(fight_remains>20|raid&boss)
# Prioritize Aimed Shot a little higher when close to capping charges.
actions.trickshots_dark+=/aimed_shot,if=(buff.precise_shots.down|debuff.spotters_mark.up&buff.moving_target.up)&buff.trick_shots.up&buff.bulletstorm.up&full_recharge_time<gcd
actions.trickshots_dark+=/rapid_fire,if=buff.trick_shots.remains>execute_time&(!talent.black_arrow|buff.deathblow.down)&(!talent.no_scope|debuff.spotters_mark.down)&(talent.no_scope|buff.bulletstorm.down)
actions.trickshots_dark+=/explosive_shot,if=talent.precision_detonation&talent.shrapnel_shot&buff.lock_and_load.down&(buff.precise_shots.down|debuff.spotters_mark.up&buff.moving_target.up)
actions.trickshots_dark+=/aimed_shot,if=(buff.precise_shots.down|debuff.spotters_mark.up&buff.moving_target.up)&buff.trick_shots.up
actions.trickshots_dark+=/explosive_shot,if=!talent.shrapnel_shot
actions.trickshots_dark+=/steady_shot,if=focus+cast_regen<focus.max
actions.trickshots_dark+=/multishot

actions.trickshots+=/explosive_shot,if=talent.precision_detonation&action.aimed_shot.in_flight&buff.trueshot.down&(!talent.shrapnel_shot|buff.lock_and_load.down)
actions.trickshots+=/multishot,if=buff.trick_shots.down
actions.trickshots+=/rapid_fire,if=buff.trick_shots.up&buff.bulletstorm.stack<5
actions.trickshots+=/explosive_shot,if=buff.lock_and_load.down&buff.trick_shots.up&(cooldown.aimed_shot.charges<2|time<10)&fight_remains>10
actions.trickshots+=/call_action_list,strict=1,name=cds
actions.trickshots+=/call_action_list,strict=1,name=trinkets
actions.trickshots+=/trueshot,if=variable.trueshot_ready&cooldown_check
actions.trickshots+=/volley,if=(buff.lock_and_load.down|!talent.shrapnel_shot)&cooldown.aimed_shot.charges<2&(fight_remains>20|raid&boss)
actions.trickshots+=/aimed_shot,if=buff.trick_shots.remains>cast_time
actions.trickshots+=/rapid_fire,if=buff.trick_shots.up&(cooldown.aimed_shot.charges<1|focus<60)
actions.trickshots+=/steady_shot,if=focus+cast_regen<focus.max&!cooldown.rapid_fire.ready
actions.trickshots+=/kill_shot,if=buff.trick_shots.up
actions.trickshots+=/multishot

actions.move_trickshots+=/multishot,if=buff.trick_shots.down
actions.move_trickshots+=/rapid_fire,if=buff.trick_shots.up&buff.bulletstorm.stack<5
actions.move_trickshots+=/explosive_shot,if=buff.lock_and_load.down&(cooldown.aimed_shot.charges<2|time<10)&fight_remains>10
actions.move_trickshots+=/trueshot,if=variable.trueshot_ready&cooldown_check
actions.move_trickshots+=/aimed_shot,if=buff.lock_and_load.up
actions.move_trickshots+=/rapid_fire,if=buff.trick_shots.up&(cooldown.aimed_shot.charges<1|focus<60)
actions.move_trickshots+=/steady_shot,if=focus+cast_regen<focus.max&!cooldown.rapid_fire.ready

actions.move_st_dark+=/explosive_shot,if=talent.precision_detonation&prev.1.aimed_shot&buff.trueshot.down&buff.lock_and_load.down
actions.move_st_dark+=/volley,if=buff.double_tap.down&(!raid_event.adds.exists|raid_event.adds.in>cooldown)
actions.move_st_dark+=/steady_shot,if=focus+cast_regen<focus.max&prev.1.aimed_shot&(!cooldown.black_arrow.ready)&buff.trueshot.down&cooldown.trueshot.remains
actions.move_st_dark+=/black_arrow,if=!talent.headshot|talent.headshot&buff.precise_shots.up&(debuff.spotters_mark.down|buff.moving_target.down)
actions.move_st_dark+=/aimed_shot,if=buff.lock_and_load.up
actions.move_st_dark+=/rapid_fire,if=!buff.deathblow.up
actions.move_st_dark+=/trueshot,if=variable.trueshot_ready&buff.double_tap.down&buff.deathblow.down
actions.move_st_dark+=/arcane_shot,if=buff.precise_shots.up&(debuff.spotters_mark.down|buff.moving_target.down)
actions.move_st_dark+=/explosive_shot,if=talent.shrapnel_shot&buff.lock_and_load.down
actions.move_st_dark+=/steady_shot

actions.move_st+=/explosive_shot,if=talent.precision_detonation&action.aimed_shot.in_flight&buff.trueshot.down
actions.move_st+=/volley,if=buff.double_tap.down&(!raid_event.adds.exists|raid_event.adds.in>cooldown)
actions.move_st+=/trueshot,if=variable.trueshot_ready&buff.double_tap.down
actions.move_st+=/rapid_fire,if=talent.lunar_storm&buff.lunar_storm_cooldown.down
actions.move_st+=/kill_shot,if=talent.headshot&buff.precise_shots.up&(debuff.spotters_mark.down|buff.moving_target.down)|!talent.headshot&buff.razor_fragments.up
actions.move_st+=/arcane_shot,if=buff.precise_shots.up&(debuff.spotters_mark.down|buff.moving_target.down)
actions.move_st+=/aimed_shot,if=buff.lock_and_load.up
actions.move_st+=/rapid_fire
actions.move_st+=/explosive_shot,if=talent.precision_detonation|buff.trueshot.down
actions.move_st+=/steady_shot


actions.move_cleave+=/explosive_shot,if=talent.precision_detonation&action.aimed_shot.in_flight&(buff.trueshot.down|!talent.windrunner_quiver)
actions.move_cleave+=/kill_shot,if=talent.black_arrow&buff.precise_shots.up&buff.moving_target.down&variable.trueshot_ready
actions.move_cleave+=/rapid_fire,if=talent.bulletstorm&buff.bulletstorm.down&(!talent.double_tap|buff.double_tap.up|!talent.aspect_of_the_hydra&buff.trick_shots.remains>execute_time)&(buff.precise_shots.down|buff.moving_target.up|!talent.volley)
actions.move_cleave+=/trueshot,if=variable.trueshot_ready&(buff.double_tap.down|!talent.volley)&(hero_tree.dark_ranger|buff.lunar_storm_cooldown.up|!talent.double_tap|!talent.volley)&(buff.precise_shots.down|buff.moving_target.up|!talent.volley)
# Sentinel
actions.move_cleave+=/rapid_fire,if=talent.lunar_storm&buff.lunar_storm_cooldown.down&(buff.precise_shots.down|buff.moving_target.up|cooldown.volley.remains&cooldown.trueshot.remains|!talent.volley)
actions.move_cleave+=/kill_shot,if=talent.black_arrow&(talent.headshot&buff.precise_shots.up&(debuff.spotters_mark.down|buff.moving_target.down)|!talent.headshot&buff.razor_fragments.up)
actions.move_cleave+=/kill_shot,cycle_targets=1,if=!talent.black_arrow&(talent.headshot&buff.precise_shots.up&(debuff.spotters_mark.down|buff.moving_target.down)|!talent.headshot&buff.razor_fragments.up)
actions.move_cleave+=/multishot,cycle_targets=1,if=buff.precise_shots.up&(debuff.spotters_mark.down|buff.moving_target.down)&!talent.aspect_of_the_hydra&(talent.symphonic_arsenal|talent.small_game_hunter)
actions.move_cleave+=/arcane_shot,cycle_targets=1,if=buff.precise_shots.up&(debuff.spotters_mark.down|buff.moving_target.down)
actions.move_cleave+=/aimed_shot,if=buff.lock_and_load.up
actions.move_cleave+=/rapid_fire,if=!talent.bulletstorm|buff.bulletstorm.stack<=10|talent.aspect_of_the_hydra
actions.move_cleave+=/rapid_fire
actions.move_cleave+=/explosive_shot,if=(talent.precision_detonation|buff.trueshot.down)&buff.lock_and_load.down
actions.move_cleave+=/kill_shot,if=talent.black_arrow&!talent.headshot
actions.move_cleave+=/steady_shot


--self
actions.trinkets+=/variable,name=sync_ready,value=variable.trueshot_ready&cooldown_check
actions.trinkets+=/variable,name=sync_active,value=buff.trueshot.up&cooldown_check
actions.trinkets+=/variable,name=sync_remains,value=cooldown.trueshot.remains&cooldown_check
actions.trinkets+=/use_item,slot=trinket1,if=trinket.1.has_use_buff&(variable.sync_ready&(variable.trinket_1_stronger|trinket.2.cooldown.remains)|!variable.sync_ready&(variable.trinket_1_stronger&(variable.sync_remains>trinket.1.cooldown.duration%3&fight_remains>trinket.1.cooldown.duration+20|trinket.2.has_use_buff&trinket.2.cooldown.remains>variable.sync_remains-15&trinket.2.cooldown.remains-5<variable.sync_remains&variable.sync_remains+45>fight_remains)|variable.trinket_2_stronger&(trinket.2.cooldown.remains&(trinket.2.cooldown.remains-5<variable.sync_remains&variable.sync_remains>=20|trinket.2.cooldown.remains-5>=variable.sync_remains&(variable.sync_remains>trinket.1.cooldown.duration%3|trinket.1.cooldown.duration<fight_remains&(variable.sync_remains+trinket.1.cooldown.duration>fight_remains)))|trinket.2.cooldown.ready&variable.sync_remains>20&variable.sync_remains<trinket.2.cooldown.duration%3)))|!trinket.1.has_use_buff&(trinket.1.cast_time=0|!variable.sync_active)&(!trinket.2.has_use_buff&(variable.trinket_1_stronger|trinket.2.cooldown.remains)|trinket.2.has_use_buff&(variable.sync_remains>20|trinket.2.cooldown.remains>20))|boss&fight_remains<25&raid&(variable.trinket_1_stronger|trinket.2.cooldown.remains)
actions.trinkets+=/use_item,slot=trinket2,if=trinket.2.has_use_buff&(variable.sync_ready&(variable.trinket_2_stronger|trinket.1.cooldown.remains)|!variable.sync_ready&(variable.trinket_2_stronger&(variable.sync_remains>trinket.2.cooldown.duration%3&fight_remains>trinket.2.cooldown.duration+20|trinket.1.has_use_buff&trinket.1.cooldown.remains>variable.sync_remains-15&trinket.1.cooldown.remains-5<variable.sync_remains&variable.sync_remains+45>fight_remains)|variable.trinket_1_stronger&(trinket.1.cooldown.remains&(trinket.1.cooldown.remains-5<variable.sync_remains&variable.sync_remains>=20|trinket.1.cooldown.remains-5>=variable.sync_remains&(variable.sync_remains>trinket.2.cooldown.duration%3|trinket.2.cooldown.duration<fight_remains&(variable.sync_remains+trinket.2.cooldown.duration>fight_remains)))|trinket.1.cooldown.ready&variable.sync_remains>20&variable.sync_remains<trinket.1.cooldown.duration%3)))|!trinket.2.has_use_buff&(trinket.2.cast_time=0|!variable.sync_active)&(!trinket.1.has_use_buff&(variable.trinket_2_stronger|trinket.1.cooldown.remains)|trinket.1.has_use_buff&(variable.sync_remains>20|trinket.1.cooldown.remains>20))|boss&fight_remains<25&raid&(variable.trinket_2_stronger|trinket.1.cooldown.remains)



actions.mitigation=/misdirection,line_cd=2,if=time<6&buff.misdirection.down
actions.mitigation+=/feign_death,if=talent.emergency_salve&(buff.dispellable_poison.up|buff.dispellable_disease.up)
actions.mitigation+=/exhilaration,if=health.pct<40
actions.mitigation+=/survival_of_the_fittest,if=health.pct<hp_gap&buff.survival_of_the_fittest.down&(range_spell_magic|target_me_spell_magic|dot_spell_magic|range_spell_physic|target_me_spell_physic|dot_spell_physic)
actions.mitigation+=/aspect_of_the_turtle,if=health.pct<30&buff.survival_of_the_fittest.down&(range_spell_magic|target_me_spell_magic|dot_spell_magic|range_spell_physic|target_me_spell_physic|dot_spell_physic)

