actions+=/call_action_list,name=move_cleave,strict=1,if=movement.distance>2&active_enemies=2
actions+=/call_action_list,name=move_trickshots,strict=1,if=movement.distance>2&(active_enemies=3&!target.moving|active_enemies>3)&talent.trick_shots
actions+=/call_action_list,name=st,strict=1,if=active_enemies<2|!talent.trick_shots&!moving
actions+=/call_action_list,name=cleave,strict=1,if=active_enemies=2
actions+=/call_action_list,name=trickshots,strict=1,if=!moving&(active_enemies=3&!target.moving|active_enemies>3)&talent.trick_shots&hero_tree.sentinel
actions+=/call_action_list,name=trickshots_dark,strict=1,if=!moving&(active_enemies=3&!target.moving|active_enemies>3)&talent.trick_shots&hero_tree.dark_ranger

actions.cds+=/berserking,if=buff.trueshot.up|boss&fight_remains<13&raid
actions.cds+=/blood_fury,if=buff.trueshot.up|cooldown.trueshot.remains>30|boss&fight_remains<16&raid
