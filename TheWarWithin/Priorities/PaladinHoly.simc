
actions.precombat+=/devotion_aura,if=buff.devotion_aura.down
actions.precombat+=/cleanse
actions.precombat+=/word_of_glory,if=(holy_power.current>2|buff.divine_purpose.up)&find.lowest_hp.pct<90
actions.precombat+=/flash_of_light,moving=0,enable_moving=true,if=find.lowest_hp.pct<90

actions.default+=/rebuke,if=target.distance<5
actions.default+=/call_action_list,name=mitigation,strict=1,if=!Pvepvp_check&!raid
actions.default+=/call_action_list,name=racial
actions.default+=/call_action_list,name=cds
actions.default+=/judgment,if=debuff.empyrean_legacy_icd.down&talent.empyrean_legacy.enabled&holy_power.current<5&target_is_enemie&(buff.awakening_ready.remains<5|health_party_pct<judgment_party_health)
actions.default+=/blessing_of_summer
actions.default+=/blessing_of_autumn
actions.default+=/blessing_of_winter
actions.default+=/blessing_of_spring
actions.default+=/judgment,if=(buff.awakening_ready.remains<5|health_party_pct<judgment_party_health)&buff.awakening_ready.up
actions.default+=/hammer_of_wrath,if=talent.veneration.enabled&target_is_enemie&target.distance<30
actions.default+=/call_action_list,strict=1,name=spenders,if=find.none_target_lowest_hp.pct=100&holy_power.current>4
actions.default+=/call_action_list,name=avenging_crusader,if=talent.avenging_crusader.enabled&buff.avenging_crusader.up&target_is_enemie
actions.default+=/call_action_list,name=aoe_healing,if=health_party_pct<90&(((!raid&find.hurt_num_big.count>1)|(raid&find.hurt_num_big.count>3))|((!raid&find.hurt_num.count>1)|(raid&find.hurt_num_big.count>3)))
actions.default+=/call_action_list,name=st_healing,if=find.lowest_hp.pct<100
actions.default+=/call_action_list,name=light_of_the_martyr,if=debuff.light_of_the_martyr.up&talent.light_of_the_martyr.enabled
actions.default+=/consecration,if=!consecration.up&target.distance<5&active_enemies>2
actions.default+=/hammer_of_wrath,if=target_is_enemie&target.distance<30
actions.default+=/flash_of_light,enable_moving=true,moving=0,if=holy_power.current<5&((target.distance>5&target_is_enemie)|!target_is_enemie)&(!moving|(buff.infusion_of_light.up|holy_power.current<5))&find.lowest_hp.pct<=100
actions.default+=/judgment,if=holy_power.current<5&target.distance<30&((buff.awakening_ready.remains<5|health_party_pct<judgment_party_health)|!talent.awakening)
actions.default+=/holy_shock,if=holy_power.current<5&find.none_target_lowest_hp.pct>95&cooldown.holy_shock.charge>1
actions.default+=/crusader_strike,if=target.distance<5&holy_power.current<5
actions.default+=/consecration,if=!consecration.up&target.distance<5
actions.default+=/light_of_dawn,if=holy_power.current=5&raid
actions.default+=/crusader_strike

actions.spenders+=/shield_of_the_righteous,if=(!talent.awakening.enabled|active_enemies>0)&target.distance<5

actions.cds+=/trinket1,enabled=0,if=find.lowest_hp.pct<40
actions.cds+=/trinket2,enabled=0,if=find.lowest_hp.pct<40
actions.cds+=/lay_on_hands,if=health.pct<=30&debuff.forbearance.down
actions.cds+=/ringing_ritual_mud,if=health.pct<50
actions.cds+=/chromebustible_bomb_suit,if=health.pct<50
actions.cds+=/blessing_of_sacrifice,if=find.lowest_hp.unit!=find.player.token&find.lowest_hp.unit!=find.tank.token&find.lowest_hp.pct<65&health.pct>70
actions.cds+=/sacred_weapon,if=(!prev_gcd.1.holy_bulwark|moving)&time>10&cooldown_check
actions.cds+=/holy_bulwark,if=(!prev_gcd.1.sacred_weapon|moving)&time>10&cooldown_check

actions.aoe_healing+=/judgment,if=buff.awakening_ready.remains>0&(buff.awakening_ready.remains<5|health_party_pct<judgment_party_health)&target_is_enemie&target.distance<30&((((!raid&find.hurt_num_big.count>1)|(raid&find.hurt_num_big.count>3))|((!raid&find.hurt_num.count>1)|(raid&find.hurt_num_big.count>3)))|find.lowest_hp.pct<40)
actions.aoe_healing+=/hand_of_divinity,moving=0,enable_moving=true

actions.aoe_healing+=/avenging_crusader,if=find.lowest_hp.pct<85&find.hurt_num_big.count>2&find.lowest_hp.pct<75&buff.avenging_crusader.down&talent.avenging_crusader.enabled&fight_remains>10
actions.aoe_healing+=/divine_toll,if=find.lowest_hp.pct<85&talent.divine_toll.enabled&(cooldown.beacon_of_virtue.remains>8|talent.beacon_of_faith.enabled)
actions.aoe_healing+=/holy_prism,if=find.none_target_lowest_hp.pct<85&find.hurt_num_big.count>2&target.distance<30&buff.avenging_wrath.down
actions.aoe_healing+=/holy_prism,if=find.none_target_lowest_hp.pct<40&find.hurt_num_big.count>2&target.distance<30
actions.aoe_healing+=/avenging_wrath,if=find.hurt_num_big.count>2&find.lowest_hp.pct<80&buff.avenging_wrath.down&health_party_pct<=avenging_wrath_party_health
actions.aoe_healing+=/tyrs_deliverance,moving=0,enable_moving=true,if=find.lowest_hp.pct<85
actions.aoe_healing+=/beacon_of_virtue,if=cooldown.beacon_of_virtue.remains=0&talent.beacon_of_virtue.enabled&find.lowest_hp.pct<85
actions.aoe_healing+=/light_of_dawn,if=holy_power.current>2&raid&!buff.empyrean_legacy.up&find.lowest_hp.pct>45&!cooldown.beacon_of_virtue.remains>8
actions.aoe_healing+=/gallagio_bottle_service,if=find.lowest_hp.pct<50

actions.st_healing+=/judgment,if=buff.awakening_ready.remains>0&(buff.awakening_ready.remains<5|health_party_pct<judgment_party_health)&target_is_enemie&target.distance<30&find.lowest_hp.pct<50
actions.st_healing+=/avenging_wrath,if=find.hurt_num_big.count>2&find.lowest_hp.pct<50&buff.avenging_wrath.down
actions.st_healing+=/divine_toll,if=find.lowest_hp.pct<65&talent.divine_toll.enabled&(cooldown.beacon_of_virtue.remains>8|talent.beacon_of_faith.enabled)&talent.rising_sunlight.enabled
actions.st_healing+=/holy_prism,if=find.lowest_hp.pct<70&target.distance<30
actions.st_healing+=/word_of_glory,if=(holy_power.current>2|buff.divine_purpose.up)&find.lowest_hp.pct<95
actions.st_healing+=/gallagio_bottle_service,if=find.lowest_hp.pct<50
actions.st_healing+=/holy_armaments,if=buff.holy_bulwark_ready.up&find.lowest_hp.pct<100
actions.st_healing+=/holy_shock,if=holy_power.current<5&buff.rising_sunlight.up&find.lowest_hp.pct<100
actions.st_healing+=/flash_of_light,moving=0,enable_moving=true,if=!moving&buff.infusion_of_light.up&raid&holy_power.current<5&find.lowest_hp.pct<100
actions.st_healing+=/holy_shock,if=holy_power.current<5&!buff.rising_sunlight.up&(moving|buff.infusion_of_light.down|!raid)&find.lowest_hp.pct<100

actions.light_of_the_martyr+=/word_of_glory,if=holy_power.current>2|buff.divine_purpose.up&find.lowest_hp.pct<100
#actions.light_of_the_martyr+=/flash_of_light,if=!moving&buff.divine_favor.up&find.lowest_hp.pct<100
actions.light_of_the_martyr+=/holy_shock,if=find.lowest_hp.pct<100

actions.racial+=/ancestral_call
actions.racial+=/arcane_torrent
actions.racial+=/bag_of_tricks
actions.racial+=/berserking
actions.racial+=/lights_judgment

actions.avenging_crusader+=/hammer_of_wrath,if=talent.veneration.enabled&holy_power.current<5&target.distance<30
actions.avenging_crusader+=/judgment,if=holy_power.current<5&target.distance<30&(buff.awakening_ready.remains<5|health_party_pct<judgment_party_health)
actions.avenging_crusader+=/crusader_strike,if=holy_power.current<5&target.distance<5

actions.mitigation+=/cleanse
actions.mitigation=/intercession,if=health.pct>70&health_party_pct>85
actions.mitigation+=/divine_shield,if=health.pct<=30&(range_spell_magic|target_me_spell_magic|dot_spell_magic|range_spell_physic|target_me_spell_physic|dot_spell_physic)
actions.mitigation+=/divine_protection,if=health.pct<=hp_gap&buff.divine_protection.down&(range_spell_magic|target_me_spell_magic|dot_spell_magic|range_spell_physic|target_me_spell_physic|dot_spell_physic)
actions.mitigation+=/word_of_glory,if=(holy_power.current>2|buff.divine_purpose.up)&find.health.pct<40
