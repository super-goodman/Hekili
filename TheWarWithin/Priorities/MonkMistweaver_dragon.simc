actions.precombat+=/detox
actions.precombat+=/renewing_mist,enable_moving=true,moving=1,if=find.lowest_hp.pct<=90&find.lowest_hp.pct>=80&!soothing_mist_casting
actions.precombat+=/vivify,if=buff.vivacious_vivification.up&find.lowest_hp.pct<=80
actions.precombat+=/soothing_mist,enable_moving=true,line_cd=1,use_while_casting=0,moving=0,if=find.lowest_hp.pct<80&healthed_player_soothing_mist_remains<=0
actions.precombat+=/enveloping_mist,if=soothing_mist_casting&find.lowest_hp.pct<=80
actions.precombat+=/vivify,if=soothing_mist_casting&find.lowest_hp.pct<=80


actions.default+=/detox
actions.default+=/spear_hand_strike
actions.default+=/potion,potion=default
actions.default+=/call_action_list,name=racials
actions.default+=/call_action_list,name=mythic,if=!raid
actions.default+=/call_action_list,name=raid,if=raid

actions+=/call_action_list,name=mitigation,strict=1,if=!Pvepvp_check&!raid
actions.mythic+=/call_action_list,name=cds_mythic,strict=1
actions.mythic+=/touch_of_death,if=target.health.current<health&target.distance<6&active_enemies>0&!soothing_mist_casting
actions.mythic+=/life_cocoon,use_while_casting=1,if=find.lowest_hp.pct<=life_cocoon_party_health&cooldown.life_cocoon.remains<=0&!soothing_mist_casting
actions.mythic+=/soothing_mist_cancel,if=find.none_target_lowest_hp.pct>95&soothing_mist_casting|find.none_target_lowest_hp.pct>80&cooldown.rising_sun_kick.full_recharge_time=0&target.distance<18&soothing_mist_casting&!target.distance=7.5
actions.mythic+=/mana_tea_cancel,if=mana.pct>95|find.none_target_lowest_hp.pct<70|health_party_pct<80|health.pct<70|moving
actions.mythic+=/soothing_mist,if=soothing_mist_casting&healthed_player_soothing_mist_remains<=1.5
actions.mythic+=/enveloping_mist,if=soothing_mist_casting&find.lowest_hp.pct<=100
actions.mythic+=/vivify,if=soothing_mist_casting&find.lowest_hp.pct<90
actions.mythic+=/thunder_focus_tea,line_cd=20,if=cooldown.rising_sun_kick.full_recharge_time=0&target.distance<18&find.none_target_lowest_hp.pct>70|(find.none_target_lowest_hp.pct<50&buff.vivacious_vivification.up&!moving|find.none_target_lowest_hp.pct<60&moving)&!soothing_mist_casting&time>0
actions.mythic+=/rushing_wind_kick,if=target.distance<18&active_enemies>0&(find.none_target_lowest_hp.pct>70|find.hurt_num_big.count>2)
actions.mythic+=/expel_harm,if=health.pct<80&(moving|!soothing_mist_casting)|buff.thunder_focus_tea.up&health.pct<50&(moving|!soothing_mist_casting)
actions.mythic+=/enveloping_mist,if=buff.thunder_focus_tea.up&find.lowest_hp.pct<60&buff.vivacious_vivification.up&!moving
actions.mythic+=/renewing_mist,if=find.lowest_hp.pct<=100&!soothing_mist_casting&!buff.thunder_focus_tea.up
actions.mythic+=/vivify,if=buff.vivacious_vivification.up&(find.lowest_hp.pct<70&!moving|find.lowest_hp.pct<80&moving)&!buff.thunder_focus_tea.up
actions.mythic+=/crackling_jade_lightning,enable_moving=true,cycle_targets=0,line_cd=3,moving=0,if=buff.jade_empowerment.up&!moving&!soothing_mist_casting&active_enemies>=1&health_party_pct>=80&!cooldown.rushing_wind_kick.full_recharge_time=0
actions.mythic+=/chi_burst,enable_moving=true,moving=0,if=active_enemies>0&find.none_target_lowest_hp.pct>80&(!cooldown.rising_sun_kick.full_recharge_time=0|!cooldown.rushing_wind_kick.full_recharge_time=0&talent.rushing_wind_kick)
actions.mythic+=/soothing_mist,enable_moving=true,line_cd=1,use_while_casting=0,moving=0,if=find.lowest_hp.pct<80&healthed_player_soothing_mist_remains<=0&!target.debuff.crackling_jade_lightning.up
actions.mythic+=/summon_jade_serpent_statue,if=((time<10)|totem.jade_serpent_statue.remains<=0)&!soothing_mist_casting
actions.mythic+=/mana_tea,if=buff.mana_tea_stack.stack>=10&mana.pct<60&!soothing_mist_casting&health_party_pct>90
actions.mythic+=/blackout_kick,if=target.distance<6&active_enemies<6
actions.mythic+=/spinning_crane_kick,if=active_enemies>=3&find.none_target_lowest_hp.pct>80&target.distance<6
actions.mythic+=/tiger_palm

actions.cds_mythic+=/ringing_ritual_mud,if=health.pct<50&!soothing_mist_casting
actions.cds_mythic+=/swarmlords_authority_444301,if=health.pct<50&!soothing_mist_casting
actions.cds_mythic+=/chromebustible_bomb_suit,if=health.pct<50&!soothing_mist_casting
actions.cds_mythic+=/celestial_conduit,if=(find.hurt_num.count>2|find.hurt_num_big.count>2)&health_party_pct<celestial_conduit_party_health&!prev_gcd.invoke_yulon_the_jade_serpent&!prev_gcd.sheiluns_gift
actions.cds_mythic+=/sheiluns_gift,enable_moving=true,line_cd=8,moving=0,if=(find.hurt_num.count>2|find.hurt_num_big.count>2)&health_party_pct<sheiluns_gift_party_health&gust_of_mist.count>=3
actions.cds_mythic+=/invoke_yulon_the_jade_serpent,if=totem.yulon.remains<=0&(find.hurt_num.count>2|find.hurt_num_big.count>2)&health_party_pct<invoke_yulon_the_jade_serpent_party_health&!prev_gcd.sheiluns_gift
actions.cds_mythic+=/gallagio_bottle_service,if=find.lowest_hp.pct<50
actions.cds_mythic+=/revival,if=find.hurt_num_big.count>3&health_party_pct<revival_party_health&!prev_gcd.invoke_yulon_the_jade_serpent&!prev_gcd.sheiluns_gift

