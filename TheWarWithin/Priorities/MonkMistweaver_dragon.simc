actions.cds_raid+=/swarmlords_authority_444301,if=health.pct<50&!soothing_mist_casting
actions.cds_raid+=/chromebustible_bomb_suit,if=health.pct<50&!soothing_mist_casting
actions.cds_raid+=/sheiluns_gift,enable_moving=true,moving=0,if=(find.hurt_num.count>2|find.hurt_num_big.count>2)&gust_of_mist.count>=3&!soothing_mist_casting&(find.none_target_lowest_hp.pct<=100|health.pct<=100)&!cooldown.rushing_wind_kick.full_recharge_time=0&cooldown.renewing_mist.charges=0&time>0
actions.cds_raid+=/celestial_conduit,if=find.hurt_num_big.count>3&health_party_pct<celestial_conduit_party_health
actions.cds_raid+=/invoke_yulon_the_jade_serpent,if=totem.yulon.remains<=0&(find.hurt_num.count>8|find.hurt_num_big.count>4)&!soothing_mist_casting
actions.cds_raid+=/gallagio_bottle_service,if=find.lowest_hp.pct<50
# actions.cds_raid+=/revival,if=find.hurt_num_big.count>3&health_party_pct<revival_party_health

actions.raid+=/call_action_list,name=cds_raid
actions.raid+=/touch_of_death,if=target.health.current<health&target.distance<6&active_enemies>0&!soothing_mist_casting
actions.raid+=/enveloping_mist,if=!soothing_mist_casting&find.lowest_hp.pct>=90&find.lowest_hp.pct<95&!cooldown.rushing_wind_kick.full_recharge_time=0&cooldown.renewing_mist.charges=0&time>0&!moving&(!buff.zen_pulse.up|buff.zen_pulse.remains>5)|soothing_mist_casting&find.lowest_hp.pct<95
actions.raid+=/vivify,if=buff.vivacious_vivification.up&find.lowest_hp.pct<=95&!cooldown.rushing_wind_kick.full_recharge_time=0&cooldown.renewing_mist.charges=0&!buff.thunder_focus_tea.up|!buff.vivacious_vivification.up&find.lowest_hp.pct>=85&find.lowest_hp.pct<=95&!cooldown.rushing_wind_kick.full_recharge_time=0&cooldown.renewing_mist.charges=0&!buff.thunder_focus_tea.up&!moving
actions.raid+=/vivify,if=soothing_mist_casting&find.lowest_hp.pct<95|buff.zen_pulse.up&find.lowest_hp.pct<100&!cooldown.rushing_wind_kick.full_recharge_time=0&cooldown.renewing_mist.charges=0&!buff.thunder_focus_tea.up&!soothing_mist_casting&!moving
actions.raid+=/life_cocoon,use_while_casting=1,if=find.lowest_hp.pct<=life_cocoon_party_health&cooldown.life_cocoon.remains<=0&!soothing_mist_casting&time>0
actions.raid+=/soothing_mist_cancel,if=find.none_target_lowest_hp.pct>95|cooldown.rushing_wind_kick.full_recharge_time=0&find.none_target_lowest_hp.pct>90
actions.raid+=/mana_tea_cancel,if=mana.pct>95|find.none_target_lowest_hp.pct<70|health_party_pct<80
actions.raid+=/thunder_focus_tea,line_cd=20,if=cooldown.renewing_mist.charges>=1&time>0
actions.raid+=/renewing_mist,enable_moving=false,if=find.lowest_hp.pct<=100&!soothing_mist_casting
actions.raid+=/expel_harm,if=health.pct<60&!soothing_mist_casting&!buff.thunder_focus_tea.up|health.pct<30&!soothing_mist_casting&buff.thunder_focus_tea.up
actions.raid+=/rushing_wind_kick,if=time>0&!soothing_mist_casting
actions.raid+=/soothing_mist,enable_moving=true,line_cd=,use_while_casting=0,moving=0,if=find.lowest_hp.pct<90&healthed_player_soothing_mist_remains<=0
actions.raid+=/summon_jade_serpent_statue,if=((time<10)|totem.jade_serpent_statue.remains<=0)&!soothing_mist_casting
actions.raid+=/mana_tea,if=((buff.mana_tea_stack.stack>=4&moving)|(buff.mana_tea_stack.stack>=3&mana.pct<80))&time>0&!soothing_mist_casting
actions.raid+=/blackout_kick,if=target.distance<6
actions.raid+=/spinning_crane_kick,if=active_enemies>=3&target.distance<8
actions.raid+=/tiger_palm

actions.mitigation+=/life_cocoon,use_while_casting=1,if=find.health.pct<=40
actions.mitigation+=/vivify,if=buff.vivacious_vivification.up&find.health.pct<=30
actions.mitigation=/diffuse_magic,if=health.pct<=hp_gap&buff.diffuse_magic.down&buff.fortifying_brew.down&(range_spell_magic|target_me_spell_magic|dot_spell_magic)
actions.mitigation+=/fortifying_brew,if=health.pct<=hp_gap&buff.diffuse_magic.down&buff.fortifying_brew.down&(range_spell_magic|target_me_spell_magic|dot_spell_magic|range_spell_physic|target_me_spell_physic|dot_spell_physic)

