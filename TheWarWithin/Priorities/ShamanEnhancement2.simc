# 在战斗开始前执行。仅接受非伤害性动作。
actions.precombat=风怒武器
actions.precombat+=火舌武器
actions.precombat+=/闪电之盾
actions.precombat+=/大地之盾
actions.precombat+=/天怒
actions.precombat+=/variable,name=trinket1_is_weird,value=trinket.1.is.algethar_puzzle_box|trinket.1.is.manic_grieftorch|trinket.1.is.elementium_pocket_anvil|trinket.1.is.beacon_to_the_beyond
actions.precombat+=/variable,name=trinket2_is_weird,value=trinket.2.is.algethar_puzzle_box|trinket.2.is.manic_grieftorch|trinket.2.is.elementium_pocket_anvil|trinket.2.is.beacon_to_the_beyond
actions.precombat+=/variable,name=min_talented_cd_remains,value=((cooldown.feral_spirit.remains%(4*talent.witch_doctors_ancestry.enabled))+1000*!talent.feral_spirit.enabled)>?(cooldown.doom_winds.remains+1000*!talent.doom_winds.enabled)>?(cooldown.ascendance.remains+1000*!talent.ascendance.enabled)
actions.precombat+=/variable,name=target_nature_mod,value=(1+debuff.chaos_brand.up*debuff.chaos_brand.value)*(1+(debuff.hunters_mark.up*target.health.pct>=80)*debuff.hunters_mark.value)
actions.precombat+=/variable,name=expected_lb_funnel,value=action.lightning_bolt.damage*(1+debuff.lightning_rod.up*variable.target_nature_mod*(1+buff.primordial_wave.up*active_dot.flame_shock*buff.primordial_wave.value)*debuff.lightning_rod.value)
actions.precombat+=/variable,name=expected_cl_funnel,value=action.chain_lightning.damage*(1+debuff.lightning_rod.up*variable.target_nature_mod*(active_enemies>?(3+2*talent.crashing_storms.enabled))*debuff.lightning_rod.value)

# 每次角色进入战斗时执行
actions=bloodlust,line_cd=600
actions+=/call_action_list,name=mitigation,strict=1,if=!Pvepvp_check
actions+=/potion,if=(buff.ascendance.up|buff.feral_spirit.up|buff.doom_winds.up|(fight_remains%%300<=30)|(!talent.ascendance.enabled&!talent.feral_spirit.enabled&!talent.doom_winds.enabled))
actions+=/use_item,name=elementium_pocket_anvil,use_off_gcd=1
actions+=/use_item,name=algethar_puzzle_box,use_off_gcd=1,if=(!buff.ascendance.up&!buff.feral_spirit.up&!buff.doom_winds.up)|(talent.ascendance.enabled&(cooldown.ascendance.remains<2*action.stormstrike.gcd))|(fight_remains%%180<=30)
actions+=/use_item,slot=trinket1,if=!variable.trinket1_is_weird&trinket.1.has_use_buff&(buff.ascendance.up|buff.feral_spirit.up|buff.doom_winds.up|(fight_remains%%trinket.1.cooldown.duration<=trinket.1.buff.any.duration)|(variable.min_talented_cd_remains>=trinket.1.cooldown.duration)|(!talent.ascendance.enabled&!talent.feral_spirit.enabled&!talent.doom_winds.enabled))
actions+=/use_item,slot=trinket2,if=!variable.trinket2_is_weird&trinket.2.has_use_buff&(buff.ascendance.up|buff.feral_spirit.up|buff.doom_winds.up|(fight_remains%%trinket.2.cooldown.duration<=trinket.2.buff.any.duration)|(variable.min_talented_cd_remains>=trinket.2.cooldown.duration)|(!talent.ascendance.enabled&!talent.feral_spirit.enabled&!talent.doom_winds.enabled))
actions+=/use_item,name=beacon_to_the_beyond,use_off_gcd=1,if=(!buff.ascendance.up&!buff.feral_spirit.up&!buff.doom_winds.up)|(fight_remains%%150<=5)
actions+=/use_item,name=manic_grieftorch,use_off_gcd=1,if=(!buff.ascendance.up&!buff.feral_spirit.up&!buff.doom_winds.up)|(fight_remains%%120<=5)
actions+=/use_item,slot=trinket1,if=!variable.trinket1_is_weird&!trinket.1.has_use_buff
actions+=/use_item,slot=trinket2,if=!variable.trinket2_is_weird&!trinket.2.has_use_buff
actions+=/blood_fury,if=(buff.ascendance.up|buff.feral_spirit.up|buff.doom_winds.up|(fight_remains%%action.blood_fury.cooldown<=action.blood_fury.duration)|(variable.min_talented_cd_remains>=action.blood_fury.cooldown)|(!talent.ascendance.enabled&!talent.feral_spirit.enabled&!talent.doom_winds.enabled))
actions+=/berserking,if=(buff.ascendance.up|buff.feral_spirit.up|buff.doom_winds.up|(fight_remains%%action.berserking.cooldown<=action.berserking.duration)|(variable.min_talented_cd_remains>=action.berserking.cooldown)|(!talent.ascendance.enabled&!talent.feral_spirit.enabled&!talent.doom_winds.enabled))
actions+=/fireblood,if=(buff.ascendance.up|buff.feral_spirit.up|buff.doom_winds.up|(fight_remains%%action.fireblood.cooldown<=action.fireblood.duration)|(variable.min_talented_cd_remains>=action.fireblood.cooldown)|(!talent.ascendance.enabled&!talent.feral_spirit.enabled&!talent.doom_winds.enabled))
actions+=/ancestral_call,if=(buff.ascendance.up|buff.feral_spirit.up|buff.doom_winds.up|(fight_remains%%action.ancestral_call.cooldown<=action.ancestral_call.duration)|(variable.min_talented_cd_remains>=action.ancestral_call.cooldown)|(!talent.ascendance.enabled&!talent.feral_spirit.enabled&!talent.doom_winds.enabled))
actions+=/call_action_list,name=单体,if=active_enemies=1&!talent.surging_totem.enabled
actions+=/call_action_list,name=群攻,if=active_enemies>1&(rotation.standard|rotation.simple)&!talent.surging_totem.enabled
actions+=/call_action_list,name=漏斗伤害,if=active_enemies>1&rotation.funnel

# AOE时优先级指令列表
actions.群攻=feral_spirit,if=talent.elemental_spirits.enabled|talent.alpha_wolf.enabled
actions.群攻+=/run_action_list,name=群攻起手,if=time<15
actions.群攻+=/run_action_list,name=群攻收手,if=active_enemies<5&interpolated_fight_remains<20
actions.群攻+=/flame_shock,if=talent.molten_assault.enabled&!ticking
actions.群攻+=/ascendance,if=(dot.flame_shock.ticking|!talent.molten_assault.enabled)&ti_chain_lightning
actions.群攻+=/tempest,target_if=min:debuff.lightning_rod.remains,if=!buff.arc_discharge.stack>=1&((buff.maelstrom_weapon.stack=buff.maelstrom_weapon.max_stack&!talent.raging_maelstrom.enabled)|(buff.maelstrom_weapon.stack>=9))|(buff.maelstrom_weapon.stack>=5&(tempest_mael_count>30))
actions.群攻+=/feral_spirit,if=(cooldown.doom_winds.remains>30|cooldown.doom_winds.remains<7)
actions.群攻+=/doom_winds
actions.群攻+=/primordial_wave,if=dot.flame_shock.ticking&(active_dot.flame_shock=active_enemies|active_dot.flame_shock=6)
actions.群攻+=/primordial_storm,if=(buff.maelstrom_weapon.stack>=10)&(buff.doom_winds.up|!talent.doom_winds.enabled|(cooldown.doom_winds.remains>buff.primordial_storm.remains)|(buff.primordial_storm.remains<2*gcd))
actions.群攻+=/crash_lightning,if=talent.converging_storms.enabled&buff.electrostatic_wager.stack>6|!buff.crash_lightning.up
actions.群攻+=/windstrike,target_if=min:debuff.lightning_rod.remains,if=talent.thorims_invocation.enabled&buff.maelstrom_weapon.stack>0&ti_chain_lightning
actions.群攻+=/crash_lightning,if=talent.converging_storms.enabled&talent.alpha_wolf.enabled
actions.群攻+=/stormstrike,if=buff.converging_storms.stack=6&buff.stormblast.stack>0&buff.legacy_of_the_frost_witch.up&buff.maelstrom_weapon.stack<=8
actions.群攻+=/crash_lightning,if=buff.maelstrom_weapon.stack<=8
actions.群攻+=/voltaic_blaze,if=buff.maelstrom_weapon.stack<=8
actions.群攻+=/chain_lightning,target_if=min:debuff.lightning_rod.remains,if=buff.maelstrom_weapon.stack>=5&!buff.primordial_storm.up&(cooldown.crash_lightning.remains>=1|!talent.alpha_wolf.enabled)
actions.群攻+=/fire_nova,if=active_dot.flame_shock=6|(active_dot.flame_shock>=4&active_dot.flame_shock=active_enemies)
actions.群攻+=/stormstrike,if=talent.stormblast.enabled&talent.stormflurry.enabled
actions.群攻+=/voltaic_blaze
actions.群攻+=/lava_lash,target_if=min:debuff.lashing_flames.remains,if=talent.lashing_flames.enabled|talent.molten_assault.enabled&dot.flame_shock.ticking
actions.群攻+=/ice_strike,if=talent.hailstorm.enabled&!buff.ice_strike.up
actions.群攻+=/frost_shock,if=talent.hailstorm.enabled&buff.hailstorm.up
actions.群攻+=/sundering
actions.群攻+=/flame_shock,if=talent.molten_assault.enabled&!ticking
actions.群攻+=/flame_shock,target_if=min:dot.flame_shock.remains,if=(talent.fire_nova.enabled|talent.primordial_wave.enabled)&(active_dot.flame_shock<active_enemies)&active_dot.flame_shock<6
actions.群攻+=/fire_nova,if=active_dot.flame_shock>=3
actions.群攻+=/stormstrike,if=buff.crash_lightning.up&(talent.deeply_rooted_elements.enabled|buff.converging_storms.stack=buff.converging_storms.max_stack)
actions.群攻+=/crash_lightning,if=talent.crashing_storms.enabled&buff.cl_crash_lightning.up
actions.群攻+=/windstrike
actions.群攻+=/stormstrike
actions.群攻+=/ice_strike
actions.群攻+=/lava_lash
actions.群攻+=/crash_lightning
actions.群攻+=/fire_nova,if=active_dot.flame_shock>=2
actions.群攻+=/chain_lightning,target_if=min:debuff.lightning_rod.remains,if=buff.maelstrom_weapon.stack>=5&!buff.primordial_storm.up
actions.群攻+=/flame_shock,if=!ticking
actions.群攻+=/frost_shock,if=!talent.hailstorm.enabled

#AOE时起手式指令列表
actions.群攻起手=flame_shock,if=!ticking
actions.群攻起手+=/primordial_storm,if=buff.primordial_storm.remains<=3&buff.maelstrom_weapon.stack>=5
actions.群攻起手+=/tempest,if=buff.primordial_storm.up&(buff.maelstrom_weapon.stack>=10|buff.primordial_storm.remains<=6&buff.maelstrom_weapon.stack>=5)&buff.tempest.stack>=1
actions.群攻起手+=/crash_lightning,if=(buff.electrostatic_wager.stack>9&buff.doom_winds.up)|!buff.crash_lightning.up
actions.群攻起手+=/voltaic_blaze,if=active_dot.flame_shock<3
actions.群攻起手+=/lava_lash,if=talent.molten_assault.enabled&(talent.primordial_wave.enabled|talent.fire_nova.enabled)&dot.flame_shock.ticking&(active_dot.flame_shock<active_enemies)&active_dot.flame_shock<3
actions.群攻起手+=/feral_spirit,if=buff.maelstrom_weapon.stack>=9
actions.群攻起手+=/ascendance,if=(dot.flame_shock.ticking|!talent.molten_assault.enabled)&ti_chain_lightning&!buff.doom_winds.up
actions.群攻起手+=/primordial_wave,if=(buff.maelstrom_weapon.stack>=4)&dot.flame_shock.ticking&(active_dot.flame_shock=active_enemies|active_dot.flame_shock=6)
actions.群攻起手+=/doom_winds,if=buff.maelstrom_weapon.stack>=9&buff.ascendance.remains<=10
actions.群攻起手+=/primordial_storm,if=(buff.maelstrom_weapon.stack>=9)&(buff.legacy_of_the_frost_witch.up|!talent.legacy_of_the_frost_witch.enabled)&buff.doom_winds.up
actions.群攻起手+=/tempest,target_if=min:debuff.lightning_rod.remains,if=buff.maelstrom_weapon.stack>=9&!buff.arc_discharge.stack>0
actions.群攻起手+=/crash_lightning,if=(buff.electrostatic_wager.stack>4)
actions.群攻起手+=/windstrike,target_if=min:debuff.lightning_rod.remains,if=talent.thorims_invocation.enabled&ti_chain_lightning
actions.群攻起手+=/chain_lightning,target_if=min:debuff.lightning_rod.remains,if=buff.maelstrom_weapon.stack>=5&(!buff.primordial_storm.up|!buff.legacy_of_the_frost_witch.up)&buff.doom_winds.up
actions.群攻起手+=/chain_lightning,target_if=min:debuff.lightning_rod.remains,if=buff.maelstrom_weapon.stack>=9&(!buff.primordial_storm.up|!buff.legacy_of_the_frost_witch.up)
actions.群攻起手+=/stormstrike,if=buff.converging_storms.stack=6&buff.stormblast.stack>1
actions.群攻起手+=/crash_lightning
actions.群攻起手+=/stormstrike

# AOE时存资源指令列表
actions.群攻收手+=/flame_shock,if=talent.molten_assault.enabled&!ticking
actions.群攻收手+=/crash_lightning,if=talent.converging_storms.enabled&buff.electrostatic_wager.stack>6|!buff.crash_lightning.up
actions.群攻收手+=/windstrike,target_if=min:debuff.lightning_rod.remains,if=talent.thorims_invocation.enabled&buff.maelstrom_weapon.stack>0&ti_chain_lightning
actions.群攻收手+=/crash_lightning,if=talent.converging_storms.enabled&talent.alpha_wolf.enabled
actions.群攻收手+=/stormstrike,if=buff.converging_storms.stack=6&buff.stormblast.stack>0&buff.legacy_of_the_frost_witch.up&buff.maelstrom_weapon.stack<=8
actions.群攻收手+=/crash_lightning,if=buff.maelstrom_weapon.stack<=8
actions.群攻收手+=/voltaic_blaze,if=buff.maelstrom_weapon.stack<=8
actions.群攻收手+=/chain_lightning,target_if=min:debuff.lightning_rod.remains,if=buff.maelstrom_weapon.stack>=5&!buff.primordial_storm.up&(cooldown.crash_lightning.remains>=1|!talent.alpha_wolf.enabled)
actions.群攻收手+=/fire_nova,if=active_dot.flame_shock=6|(active_dot.flame_shock>=4&active_dot.flame_shock=active_enemies)
actions.群攻收手+=/stormstrike,if=talent.stormblast.enabled&talent.stormflurry.enabled
actions.群攻收手+=/voltaic_blaze
actions.群攻收手+=/lava_lash,target_if=min:debuff.lashing_flames.remains,if=talent.lashing_flames.enabled|talent.molten_assault.enabled&dot.flame_shock.ticking
actions.群攻收手+=/ice_strike,if=talent.hailstorm.enabled&!buff.ice_strike.up
actions.群攻收手+=/frost_shock,if=talent.hailstorm.enabled&buff.hailstorm.up
actions.群攻收手+=/sundering
actions.群攻收手+=/flame_shock,if=talent.molten_assault.enabled&!ticking
actions.群攻收手+=/flame_shock,target_if=min:dot.flame_shock.remains,if=(talent.fire_nova.enabled|talent.primordial_wave.enabled)&(active_dot.flame_shock<active_enemies)&active_dot.flame_shock<6
actions.群攻收手+=/fire_nova,if=active_dot.flame_shock>=3
actions.群攻收手+=/stormstrike,if=buff.crash_lightning.up&(talent.deeply_rooted_elements.enabled|buff.converging_storms.stack=buff.converging_storms.max_stack)
actions.群攻收手+=/crash_lightning,if=talent.crashing_storms.enabled&buff.cl_crash_lightning.up
actions.群攻收手+=/windstrike
actions.群攻收手+=/stormstrike
actions.群攻收手+=/ice_strike
actions.群攻收手+=/lava_lash
actions.群攻收手+=/crash_lightning
actions.群攻收手+=/fire_nova,if=active_dot.flame_shock>=2
actions.群攻收手+=/chain_lightning,target_if=min:debuff.lightning_rod.remains,if=buff.maelstrom_weapon.stack>=5&!buff.primordial_storm.up
actions.群攻收手+=/flame_shock,if=!ticking
actions.群攻收手+=/frost_shock,if=!talent.hailstorm.enabled

# 漏斗伤害优先级指令列表
actions.漏斗伤害=feral_spirit,if=talent.elemental_spirits.enabled
actions.漏斗伤害+=/surging_totem
actions.漏斗伤害+=/ascendance
actions.漏斗伤害+=/windstrike,if=(talent.thorims_invocation.enabled&buff.maelstrom_weapon.stack>0)|buff.converging_storms.stack=buff.converging_storms.max_stack
actions.漏斗伤害+=/tempest,if=buff.maelstrom_weapon.stack=buff.maelstrom_weapon.max_stack|(buff.maelstrom_weapon.stack>=5&(tempest_mael_count>30|buff.awakening_storms.stack=2))
actions.漏斗伤害+=/lightning_bolt,if=(active_dot.flame_shock=active_enemies|active_dot.flame_shock=6)&buff.primordial_wave.up&buff.maelstrom_weapon.stack=buff.maelstrom_weapon.max_stack&(!buff.splintered_elements.up|fight_remains<=12|raid_event.adds.remains<=gcd)
actions.漏斗伤害+=/elemental_blast,if=buff.maelstrom_weapon.stack>=5&talent.elemental_spirits.enabled&feral_spirit.active>=4
actions.漏斗伤害+=/lightning_bolt,if=talent.supercharge.enabled&buff.maelstrom_weapon.stack=buff.maelstrom_weapon.max_stack&(variable.expected_lb_funnel>variable.expected_cl_funnel)
actions.漏斗伤害+=/chain_lightning,if=(talent.supercharge.enabled&buff.maelstrom_weapon.stack=buff.maelstrom_weapon.max_stack)|buff.arc_discharge.up&buff.maelstrom_weapon.stack>=5
actions.漏斗伤害+=/lava_lash,if=(talent.molten_assault.enabled&dot.flame_shock.ticking&(active_dot.flame_shock<active_enemies)&active_dot.flame_shock<6)|(talent.ashen_catalyst.enabled&buff.ashen_catalyst.stack=buff.ashen_catalyst.max_stack)
actions.漏斗伤害+=/primordial_wave,target_if=min:dot.flame_shock.remains,if=!buff.primordial_wave.up
actions.漏斗伤害+=/elemental_blast,if=(!talent.elemental_spirits.enabled|(talent.elemental_spirits.enabled&(charges=max_charges|buff.feral_spirit.up)))&buff.maelstrom_weapon.stack=buff.maelstrom_weapon.max_stack
actions.漏斗伤害+=/feral_spirit
actions.漏斗伤害+=/doom_winds
actions.漏斗伤害+=/stormstrike,if=buff.converging_storms.stack=buff.converging_storms.max_stack
actions.漏斗伤害+=/lava_burst,if=(buff.molten_weapon.stack>buff.crackling_surge.stack)&buff.maelstrom_weapon.stack=buff.maelstrom_weapon.max_stack
actions.漏斗伤害+=/lightning_bolt,if=buff.maelstrom_weapon.stack=buff.maelstrom_weapon.max_stack&(variable.expected_lb_funnel>variable.expected_cl_funnel)
actions.漏斗伤害+=/chain_lightning,if=buff.maelstrom_weapon.stack=buff.maelstrom_weapon.max_stack
actions.漏斗伤害+=/crash_lightning,if=buff.doom_winds.up|!buff.crash_lightning.up|(talent.alpha_wolf.enabled&feral_spirit.active&alpha_wolf_min_remains=0)|(talent.converging_storms.enabled&buff.converging_storms.stack<buff.converging_storms.max_stack)
actions.漏斗伤害+=/sundering,if=buff.doom_winds.up|talent.earthsurge.enabled
actions.漏斗伤害+=/fire_nova,if=active_dot.flame_shock=6|(active_dot.flame_shock>=4&active_dot.flame_shock=active_enemies)
actions.漏斗伤害+=/ice_strike,if=talent.hailstorm.enabled&!buff.ice_strike.up
actions.漏斗伤害+=/frost_shock,if=talent.hailstorm.enabled&buff.hailstorm.up
actions.漏斗伤害+=/sundering
actions.漏斗伤害+=/flame_shock,if=talent.molten_assault.enabled&!ticking
actions.漏斗伤害+=/flame_shock,target_if=min:dot.flame_shock.remains,if=(talent.fire_nova.enabled|talent.primordial_wave.enabled)&(active_dot.flame_shock<active_enemies)&active_dot.flame_shock<6
actions.漏斗伤害+=/fire_nova,if=active_dot.flame_shock>=3
actions.漏斗伤害+=/stormstrike,if=buff.crash_lightning.up&talent.deeply_rooted_elements.enabled
actions.漏斗伤害+=/crash_lightning,if=talent.crashing_storms.enabled&buff.cl_crash_lightning.up&active_enemies>=4
actions.漏斗伤害+=/windstrike
actions.漏斗伤害+=/stormstrike
actions.漏斗伤害+=/ice_strike
actions.漏斗伤害+=/lava_lash
actions.漏斗伤害+=/crash_lightning
actions.漏斗伤害+=/fire_nova,if=active_dot.flame_shock>=2
actions.漏斗伤害+=/elemental_blast,if=(!talent.elemental_spirits.enabled|(talent.elemental_spirits.enabled&(charges=max_charges|buff.feral_spirit.up)))&buff.maelstrom_weapon.stack>=5
actions.漏斗伤害+=/lava_burst,if=(buff.molten_weapon.stack>buff.crackling_surge.stack)&buff.maelstrom_weapon.stack>=5
actions.漏斗伤害+=/lightning_bolt,if=buff.maelstrom_weapon.stack>=5&(variable.expected_lb_funnel>variable.expected_cl_funnel)
actions.漏斗伤害+=/chain_lightning,if=buff.maelstrom_weapon.stack>=5
actions.漏斗伤害+=/flame_shock,if=!ticking
actions.漏斗伤害+=/frost_shock,if=!talent.hailstorm.enabled
actions.漏斗伤害+=/earth_shock,if=talent.hailstorm.s

# 单目标时优先级指令列表
# 开始战斗时间小于18秒
actions.单体=run_action_list,name=单体起手,if=time<18
actions.单体+=run_action_list,name=单体收手,if=interpolated_fight_remains<20|(boss&target.health.pct<5)|target.health.pct<10
actions.单体+=/primordial_storm,if=(buff.maelstrom_weapon.stack>=10|buff.primordial_storm.remains<=4&buff.maelstrom_weapon.stack>=5)
actions.单体+=/flame_shock,if=!ticking&(talent.ashen_catalyst.enabled|talent.primordial_wave.enabled|talent.lashing_flames.enabled)
actions.单体+=/feral_spirit,if=(cooldown.doom_winds.remains>30|cooldown.doom_winds.remains<7)
actions.单体+=/windstrike,if=talent.thorims_invocation.enabled&buff.maelstrom_weapon.stack>0&ti_lightning_bolt
actions.单体+=/doom_winds,if=buff.legacy_of_the_frost_witch.up&(cooldown.feral_spirit.remains>30|cooldown.feral_spirit.remains<2)
actions.单体+=/primordial_wave,if=dot.flame_shock.ticking&(raid_event.adds.in>action.primordial_wave.cooldown|raid_event.adds.in<6)
actions.单体+=/ascendance,if=(dot.flame_shock.ticking|!talent.primordial_wave.enabled|!talent.ashen_catalyst.enabled)
actions.单体+=/windstrike,if=talent.thorims_invocation.enabled&buff.maelstrom_weapon.stack>0&ti_lightning_bolt
actions.单体+=/elemental_blast,if=((!talent.overflowing_maelstrom.enabled&buff.maelstrom_weapon.stack>=5)|(buff.maelstrom_weapon.stack>=9))&charges_fractional>=1.8
actions.单体+=/tempest,if=(buff.tempest.stack=buff.tempest.max_stack&(tempest_mael_count>30|buff.awakening_storms.stack=3)&buff.maelstrom_weapon.stack>=9)
actions.单体+=/lightning_bolt,if=buff.maelstrom_weapon.stack>=9&!buff.primordial_storm.up&buff.arc_discharge.stack>1
actions.单体+=/elemental_blast,if=((!talent.overflowing_maelstrom.enabled&buff.maelstrom_weapon.stack>=5)|(buff.maelstrom_weapon.stack>=9))
actions.单体+=/tempest,if=buff.maelstrom_weapon.stack>=9
actions.单体+=/lightning_bolt,if=buff.maelstrom_weapon.stack>=9
actions.单体+=/lava_lash,if=(buff.hot_hand.up&(buff.ashen_catalyst.stack=buff.ashen_catalyst.max_stack))|(dot.flame_shock.remains<=2&!talent.voltaic_blaze.enabled)|(talent.lashing_flames.enabled&(debuff.lashing_flames.down))
actions.单体+=/crash_lightning,if=(buff.doom_winds.up&buff.electrostatic_wager.stack>1)|buff.electrostatic_wager.stack>8
actions.单体+=/stormstrike,if=buff.doom_winds.up|buff.stormblast.stack>0
actions.单体+=/crash_lightning,if=talent.unrelenting_storms.enabled&talent.alpha_wolf.enabled&alpha_wolf_min_remains=0
actions.单体+=/lava_lash,if=buff.hot_hand.up
actions.单体+=/crash_lightning,if=set_bonus.tww2_4pc
actions.单体+=/voltaic_blaze
actions.单体+=/stormstrike
actions.单体+=/lava_lash,if=talent.elemental_assault.enabled&talent.molten_assault.enabled&dot.flame_shock.ticking
actions.单体+=/ice_strike
actions.单体+=/lightning_bolt,if=buff.maelstrom_weapon.stack>=5&!buff.primordial_storm.up
actions.单体+=/frost_shock,if=buff.hailstorm.up
actions.单体+=/flame_shock,if=!ticking
actions.单体+=/sundering,if=raid_event.adds.in>=action.sundering.cooldown
actions.单体+=/crash_lightning
actions.单体+=/frost_shock
actions.单体+=/fire_nova,if=active_dot.flame_shock
actions.单体+=/earth_elemental
actions.单体+=/flame_shock

# 单目标时起手式指令列表
actions.单体起手=flame_shock,if=!ticking
actions.单体起手+=/voltaic_blaze,if=active_dot.flame_shock<3
actions.单体起手+=/lava_lash,if=talent.molten_assault.enabled&(talent.primordial_wave.enabled|talent.fire_nova.enabled)&dot.flame_shock.ticking&(active_dot.flame_shock<active_enemies)&active_dot.flame_shock<3
actions.单体起手+=/feral_spirit,if=buff.maelstrom_weapon.stack>=9
actions.单体起手+=/ascendance,if=(dot.flame_shock.ticking|!talent.molten_assault.enabled)&ti_lightning_bolt&!buff.doom_winds.up
actions.单体起手+=/primordial_wave,if=(buff.maelstrom_weapon.stack>=4)&dot.flame_shock.ticking&(active_dot.flame_shock=active_enemies|active_dot.flame_shock=6)
actions.单体起手+=/doom_winds,if=buff.maelstrom_weapon.stack>=9&buff.ascendance.remains<=10
actions.单体起手+=/primordial_storm,if=(buff.maelstrom_weapon.stack>=9)&(buff.legacy_of_the_frost_witch.up|!talent.legacy_of_the_frost_witch.enabled)&buff.doom_winds.up
actions.单体起手+=/tempest,target_if=min:debuff.lightning_rod.remains,if=buff.maelstrom_weapon.stack>=9&!buff.arc_discharge.stack>0
actions.单体起手+=/windstrike,target_if=min:debuff.lightning_rod.remains,if=talent.thorims_invocation.enabled&ti_lightning_bolt
actions.单体起手+=/lightning_bolt,target_if=min:debuff.lightning_rod.remains,if=buff.maelstrom_weapon.stack>=5&(!buff.primordial_storm.up|!buff.legacy_of_the_frost_witch.up)&buff.doom_winds.up
actions.单体起手+=/lightning_bolt,target_if=min:debuff.lightning_rod.remains,if=buff.maelstrom_weapon.stack>=9&(!buff.primordial_storm.up|!buff.legacy_of_the_frost_witch.up)
actions.单体起手+=/stormstrike,if=buff.converging_storms.stack=6&buff.stormblast.stack>1
actions.单体起手+=/stormstrike

