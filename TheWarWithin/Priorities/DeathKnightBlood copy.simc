actions.precombat+=/variable,name=bone_shield_refresh_value,value=7
actions.precombat+=/raise_dead,use_off_gcd=1

actions+=/mind_freeze
actions+=/call_action_list,name=mitigation,if=cooldown_check

actions+=/tank_combat_wait,if=time<combat_delay&moving
actions+=/tank_combat_wait,if=time<combat_delay&time<combat_delay/2&moving
actions+=/use_item,name=tome_of_lights_devotion,if=buff.inner_resilience.up
actions+=/use_item,name=unyielding_netherprism,if=cooldown.dancing_rune_weapon.remains<1|raid&boss&fight_remains<=20,use_off_gcd=1
actions+=/use_item,name=bestinslots,use_off_gcd=1
actions+=/use_items,if=!trinket.1.is.chromebustible_bomb_suit&!trinket.1.is.ringing_ritual_mud&!trinket.1.is.tome_of_lights_devotion_443535&!trinket.2.is.chromebustible_bomb_suit&!trinket.2.is.ringing_ritual_mud&!trinket.2.is.tome_of_lights_devotion_443535
actions+=/blood_fury,if=buff.dancing_rune_weapon.up
actions+=/berserking,if=buff.dancing_rune_weapon.up
actions+=/ancestral_call,if=buff.dancing_rune_weapon.up
actions+=/fireblood,if=buff.dancing_rune_weapon.up
actions+=/potion,if=buff.dancing_rune_weapon.up
actions+=/call_action_list,name=san_cds,strict=1,if=hero_tree.sanlayn
actions+=/call_action_list,name=db_cds,strict=1,if=!hero_tree.sanlayn
actions+=/variable,name=rp_deficit_threshold,value=15+(10*talent.relish_in_blood.enabled)+(3*talent.runic_attenuation.enabled)+(spell_targets.heart_strike*talent.heartbreaker.enabled*2)
actions+=/blood_tap,use_off_gcd=1,if=(rune<=2&rune.time_to_3>gcd.max&charges_fractional>=1.8)
actions+=/blood_tap,use_off_gcd=1,if=(rune<=1&rune.time_to_3>gcd.max)
actions+=/death_strike,if=cooldown_check&(health.pct<death_strike_damage|(runic_power>120|health.pct<95&runic_power>100)&(buff.dancing_rune_weapon.down&!buff.death_and_decay.up|buff.dancing_rune_weapon.down))
actions+=/deaths_caress,if=buff.bone_shield.remains<gcd.max*4&time>5&buff.dancing_rune_weapon.down

actions+=/blood_boil,line_cd=2,if=dot.blood_plague.remains<gcd.max*2|(active_dot.blood_plague<active_enemies|time<20&!boss&runic_power>40)&buff.dancing_rune_weapon.down&!buff.death_and_decay.up
actions+=/any_dnd,if=!buff.death_and_decay.up|buff.crimson_scourge.up
actions+=/soul_reaper,if=active_enemies=1&(target.time_to_pct_35<5)&target.time_to_die>(dot.soul_reaper.remains+5)&(!hero_tree.sanlayn|pet.dancing_rune_weapon.remains<5)
actions+=/run_action_list,name=san_drw,strict=1,if=hero_tree.sanlayn&buff.dancing_rune_weapon.up

actions+=/run_action_list,name=sanlayn,strict=1,if=hero_tree.sanlayn

actions+=/run_action_list,name=deathbringer,strict=1,if=!hero_tree.sanlayn


actions.db_cds+=/dancing_rune_weapon,if=fight_remains>35|raid
actions.db_cds=reapers_mark,if=fight_remains>30|raid
actions.db_cds+=/bonestorm,if=buff.death_and_decay.up&buff.bone_shield.stack>=10&(fight_remains>30|raid)&(active_enemies>3|boss)
actions.db_cds+=/tombstone,if=buff.death_and_decay.up&buff.bone_shield.stack>=10&runic_power.deficit>=30&(fight_remains>30|raid)&(active_enemies>3|boss)
actions.db_cds+=/abomination_limb,if=!buff.dancing_rune_weapon.up&active_enemies>3


actions.deathbringer+=/marrowrend,if=(buff.dancing_rune_weapon.up&buff.bone_shield.stack<12|buff.bone_shield.stack<10)&(fight_remains>15|buff.exterminate.down|buff.bone_shield.stack<9)
actions.deathbringer+=/marrowrend,if=buff.exterminate.up&(fight_remains>15|raid)
actions.deathbringer+=/heart_strike,if=runic_power<40&buff.death_and_decay.up
actions.deathbringer+=/marrowrend,if=buff.bone_shield.stack<6&!dot.bonestorm.ticking&(fight_remains>15|buff.exterminate.down|buff.bone_shield.stack<9)
actions.deathbringer+=/blood_boil,if=pet.dancing_rune_weapon.active&!drw.bp_ticking
actions.deathbringer+=/soul_reaper,if=buff.reaper_of_souls.up&cooldown.dancing_rune_weapon.remains
actions.deathbringer+=/blooddrinker,if=!buff.dancing_rune_weapon.up&active_enemies<=2&buff.coagulopathy.remains>3
actions.deathbringer+=/consumption
actions.deathbringer+=/blood_boil,if=charges_fractional>=1.5
actions.deathbringer+=/heart_strike,if=rune>=1|rune.time_to_2<gcd
actions.deathbringer+=/blood_boil
actions.deathbringer+=/heart_strike
actions.deathbringer+=/arcane_torrent,if=runic_power.deficit>20
actions.deathbringer+=/deaths_caress,if=buff.bone_shield.stack<11

## actions.san_cds=abomination_limb,if=!buff.dancing_rune_weapon.up&active_enemies>3
actions.san_cds+=/dancing_rune_weapon,if=(fight_remains>40|raid)&buff.death_and_decay.up
actions.san_cds+=/bonestorm,if=buff.death_and_decay.up&buff.bone_shield.stack>=10&fight_remains>30&(active_enemies>3|boss)
actions.san_cds+=/tombstone,if=buff.death_and_decay.up&buff.bone_shield.stack>=10&runic_power.deficit>=30&fight_remains>30&(active_enemies>3|boss)
actions.san_drw+=/marrowrend,if=buff.dancing_rune_weapon.up&buff.bone_shield.stack<12|buff.bone_shield.stack<10
actions.san_drw+=/bonestorm,if=buff.death_and_decay.up&buff.bone_shield.stack>10
actions.san_drw+=/blood_boil,if=!drw.bp_ticking
actions.san_drw+=/heart_strike
actions.san_drw+=/consumption
actions.san_drw+=/blood_boil

actions.sanlayn+=/marrowrend,if=buff.dancing_rune_weapon.up&buff.bone_shield.stack<12|buff.bone_shield.stack<10
actions.sanlayn+=/heart_strike,if=buff.infliction_of_sorrow.up
actions.sanlayn+=/heart_strike,if=buff.vampiric_strike.up
actions.sanlayn+=/blooddrinker,if=!buff.dancing_rune_weapon.up&active_enemies<=2&buff.coagulopathy.remains>3
actions.sanlayn+=/marrowrend,if=!dot.bonestorm.ticking&buff.bone_shield.stack<variable.bone_shield_refresh_value&runic_power.deficit>20
actions.sanlayn+=/heart_strike,if=rune>1
actions.sanlayn+=/consumption
actions.sanlayn+=/blood_boil
actions.sanlayn+=/heart_strike

actions.mitigation+=/raise_ally,if=runic_power>40
actions.mitigation+=/death_strike,if=incoming_damage_3s>=health.max*(1-0.01*death_strike_damage)&cooldown_check&(health.pct<death_strike_damage|runic_power>120|health.pct<95&runic_power>100)
actions.mitigation+=/vampiric_blood,if=incoming_damage_3s>=vb_damage&!(buff.dancing_rune_weapon.up|buff.icebound_fortitude.up)|(time<10&time>=0&active_enemies>4&cooldown.dancing_rune_weapon.remains>5&buff.dancing_rune_weapon.down|active_enemies>10)&buff.rune_tap.down&buff.icebound_fortitude.down&buff.lichborne.down
actions.mitigation+=/icebound_fortitude,if=incoming_damage_3s>=ibf_damage&!(buff.dancing_rune_weapon.up|buff.vampiric_blood.up)|(time<10&time>=0&active_enemies>4&cooldown.dancing_rune_weapon.remains>5&buff.dancing_rune_weapon.down|active_enemies>10&fight_remains>15)&buff.rune_tap.down&buff.vampiric_blood.down&buff.lichborne.down
actions.mitigation+=/rune_tap,if=incoming_damage_3s>=rt_damage&!(buff.dancing_rune_weapon.up|buff.icebound_fortitude.up|buff.vampiric_blood.up)|time<10&time>=0&active_enemies>4&cooldown.dancing_rune_weapon.remains>5&buff.dancing_rune_weapon.down&buff.icebound_fortitude.down&buff.vampiric_blood.down&buff.lichborne.down
actions.mitigation+=/lichborne,if=incoming_damage_3s>=vb_damage&!(buff.dancing_rune_weapon.up|buff.icebound_fortitude.up|buff.vampiric_blood.up)|time<10&time>=0&active_enemies>4&cooldown.dancing_rune_weapon.remains>5&buff.dancing_rune_weapon.down&buff.icebound_fortitude.down&buff.vampiric_blood.down&buff.rune_tap.down

