actions.precombat+=/arcane_intellect
actions.precombat+=/variable,name=treacherous_transmitter_precombat_cast,value=12

actions+=/counterspell
actions+=/mirror_image
actions+=/use_item,name=treacherous_transmitter
actions+=/use_item,name=ingenious_mana_battery
actions+=/call_action_list,name=mitigation,strict=1,if=!pvepvp_check&!raid
actions+=/call_action_list,name=cds,if=cooldown_check
actions+=/run_action_list,name=aoe_ff,strict=1,if=talent.frostfire_bolt&active_enemies>=3&!moving
actions+=/run_action_list,name=move_aoe_ff,strict=1,if=talent.frostfire_bolt&active_enemies>=3&moving
actions+=/run_action_list,name=aoe_ss,strict=1,if=!talent.frostfire_bolt&active_enemies>=3
