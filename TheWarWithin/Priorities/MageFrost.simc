actions.cds+=/potion,if=buff.icy_veins.remains>9
actions.cds+=/icy_veins,if=buff.icy_veins.remains<gcd.max*2&(fight_remains>30|raid)
# Manual change from time=0, which the sims use but the addon cannot
actions.cds+=/flurry,if=time<0.2&active_enemies<=2
actions.cds+=/use_item,name=neural_synapse_enhancer,if=active_enemies<=2|prev_gcd.1.comet_storm|boss&fight_remains<20&raid
actions.cds+=/use_items,if=buff.icy_veins.remains>10
