actions.precombat+=/rushing_jade_wind,if=buff.rushing_jade_wind.remains<=1

actions+=/detox
actions+=/spear_hand_strike
actions+=/call_action_list,name=combo,if=cooldown_check&talent.blackout_combo&buff.blackout_combo.up
actions+=/call_action_list,name=mitigation,if=cooldown_check
actions+=/tank_combat_wait,if=time<combat_delay&moving
actions+=/tank_combat_wait,if=time<combat_delay&time<combat_delay/2&moving
actions+=/potion
actions+=/chromebustible_bomb_suit,if=health.pct<50
actions+=/use_item,slot=trinket1,enabled=0
actions+=/use_item,slot=trinket2,enabled=0
actions+=/use_items,if=buff.weapons_of_order.up&!trinket.1.is.chromebustible_bomb_suit&!trinket.1.is.ringing_ritual_mud&!trinket.1.is.tome_of_lights_devotion_443535&!trinket.2.is.chromebustible_bomb_suit&!trinket.2.is.ringing_ritual_mud&!trinket.2.is.tome_of_lights_devotion_443535
actions+=/call_action_list,name=racial,if=cooldown_check
actions+=/call_action_list,name=aoe,if=cooldown_check&active_enemies>1
actions+=/call_action_list,name=st,if=cooldown_check&active_enemies<2

actions.combo+=/rushing_jade_wind,if=buff.rushing_jade_wind.remains<=1
actions.combo+=/purifying_brew,if=stagger.heavy&!settings.combo_max_damage
actions.combo+=/celestial_brew,if=health.pct<=60&!settings.combo_max_damage&buff.celestial_brew.down
actions.combo+=/celestial_infusion,if=health.pct<=60&!settings.combo_max_damage&buff.celestial_infusion.down
actions.combo+=/keg_smash,if=time<15
actions.combo+=/keg_smash,if=(talent.celestial_brew&!cooldown.celestial_brew.ready|talent.celestial_infusion&!cooldown.celestial_infusion.ready)&cooldown.purifying_brew.charges<2|incoming_damage_3s>health.max*(0.2+(0.2*group))
actions.combo+=/tiger_palm
actions.combo+=/keg_smash

actions.aoe+=/rushing_jade_wind,if=buff.rushing_jade_wind.remains<=1
actions.aoe+=/weapons_of_order
actions.aoe+=/invoke_niuzao
actions.aoe+=/summon_black_ox_statue,enabled=0,if=time>12
actions.aoe+=/spinning_crane_kick,if=talent.charred_passions.enabled&talent.scalding_brew.enabled&buff.charred_passions.up&time<15
actions.aoe+=/blackout_kick,if=cooldown_check&(time>8|!moving)&buff.blackout_combo.down
actions.aoe+=/keg_smash,line_cd=2
actions.aoe+=/breath_of_fire,if=debuff.keg_smash.up&((buff.charred_passions.down&(!talent.scalding_brew.enabled|active_enemies<5))|!talent.charred_passions.enabled|(dot.breath_of_fire.remains<3&talent.scalding_brew.enabled)|active_dot.breath_of_fire<active_enemies)&!buff.blackout_combo.up
actions.aoe+=/exploding_keg,if=!moving
actions.aoe+=/chi_burst,if=!moving&time>10
actions.aoe+=/spinning_crane_kick,if=time<10|moving
actions.aoe+=/keg_smash
actions.aoe+=/breath_of_fire,if=debuff.keg_smash.up
actions.aoe+=/tiger_palm,if=energy>40&buff.blackout_combo.up
actions.aoe+=/rising_sun_kick,if=talent.vivacious_vivification.enabled&buff.vivacious_vivification.down&health.pct<=settings.vivify_percent
actions.aoe+=/spinning_crane_kick,if=energy>40-cooldown.keg_smash.remains*energy.regen&time<15
actions.aoe+=/rising_sun_kick,if=!talent.fluidity_of_motion.enabled
actions.aoe+=/tiger_palm,if=buff.blackout_combo.up
actions.aoe+=/rising_sun_kick,if=talent.fluidity_of_motion.enabled
actions.aoe+=/tiger_palm,if=energy>40-cooldown.keg_smash.remains*energy.regen

actions.st+=/rushing_jade_wind,
actions.st+=/weapons_of_order
actions.st+=/invoke_niuzao
actions.st+=/blackout_kick
actions.st+=/chi_burst,if=!moving&time>10
actions.st+=/rising_sun_kick,if=!talent.fluidity_of_motion.enabled
actions.st+=/tiger_palm,if=buff.blackout_combo.up
actions.st+=/keg_smash,if=talent.scalding_brew.enabled
actions.st+=/spinning_crane_kick,if=talent.charred_passions.enabled&talent.scalding_brew.enabled&buff.charred_passions.up&buff.charred_passions.remains<3&dot.breath_of_fire.remains<9&active_enemies>4
actions.st+=/rising_sun_kick,if=talent.fluidity_of_motion.enabled
actions.st+=/purifying_brew,if=buff.blackout_combo.down
actions.st+=/breath_of_fire,if=(buff.charred_passions.down&(!talent.scalding_brew.enabled|active_enemies<5))|!talent.charred_passions.enabled|(dot.breath_of_fire.remains<3&talent.scalding_brew.enabled)
actions.st+=/exploding_keg,if=!moving
actions.st+=/keg_smash
actions.st+=/tiger_palm,if=energy>40-cooldown.keg_smash.remains*energy.regen
actions.st+=/spinning_crane_kick,if=energy>40-cooldown.keg_smash.remains*energy.regen
actions.racial+=/blood_fury
actions.racial+=/berserking
actions.racial+=/arcane_torrent
actions.racial+=/lights_judgment
actions.racial+=/fireblood
actions.racial+=/ancestral_call
actions.racial+=/bag_of_tricks

actions.mitigation+=/expel_harm,if=buff.gift_of_the_ox.stack>2&health.pct<settings.eh_percent
actions.mitigation+=/black_ox_brew,if=(!talent.celestial_brew.enabled|cooldown.celestial_brew.charges<1)&(!talent.celestial_infusion.enabled|cooldown.celestial_infusion.charges<1)&cooldown.purifying_brew.charges<1
actions.mitigation+=/vivify,if=health.pct<=settings.vivify_percent&buff.vivacious_vivification.up
actions.mitigation+=/purifying_brew,if=tanking&settings.purify_for_celestial_max&(time_to_max_charges<gcd.max|buff.purified_chi.up&buff.purified_chi.remains<1.5*gcd.max)
actions.mitigation+=/celestial_brew,if=tanking&buff.celestial_brew.down&buff.purified_chi.up&(!settings.combo_max_damage|buff.blackout_combo.down)
actions.mitigation+=/celestial_infusion,if=tanking&buff.celestial_infusion.down&buff.purified_chi.up&(!settings.combo_max_damage|buff.blackout_combo.down)
actions.mitigation+=/purifying_brew,if=group&(!settings.combo_max_damage|buff.blackout_combo.down)&settings.purify_stagger_currhp>0&stagger.pct>=settings.purify_stagger_currhp
actions.mitigation+=/purifying_brew,if=solo&(!settings.combo_max_damage|buff.blackout_combo.down)&settings.purify_stagger_currhp>0&stagger.pct>=settings.purify_stagger_currhp*0.5
actions.mitigation+=/purifying_brew,if=group&(settings.combo_max_damage&buff.blackout_combo.down)&settings.purify_stagger_maxhp>0&stagger.pct>=settings.purify_stagger_maxhp
actions.mitigation+=/purifying_brew,if=solo&(!settings.combo_max_damage|buff.blackout_combo.down)&settings.purify_stagger_maxhp>0&stagger.pct>=settings.purify_stagger_maxhp*0.5
actions.mitigation+=/purifying_brew,if=group&(!settings.combo_max_damage|buff.blackout_combo.down)&settings.purify_stagger_currhp=0&settings.purify_stagger_maxhp=0&stagger.pct>20
actions.mitigation+=/purifying_brew,if=solo&(!settings.combo_max_damage|buff.blackout_combo.down)&settings.purify_stagger_currhp=0&settings.purify_stagger_maxhp=0&stagger.pct>10
actions.mitigation+=/dampen_harm,if=health.pct<50&incoming_damage_3s>health.max*(0.2+(0.2*group))&buff.fortifying_brew.down&buff.diffuse_magic.down
actions.mitigation+=/fortifying_brew,if=health.pct<50&incoming_damage_3s>health.max*(0.2+(0.2*group))&buff.dampen_harm.down&buff.diffuse_magic.down
actions.mitigation+=/celestial_infusion,if=(!settings.combo_max_damage|buff.blackout_combo.down)&buff.aspect_of_harmony_accumulator.value>0.3*health.max&buff.weapons_of_order.up&!dot.aspect_of_harmony_damage.ticking
actions.mitigation+=/celestial_infusion,if=(!settings.combo_max_damage|buff.blackout_combo.down)&buff.aspect_of_harmony_accumulator.value>0.3*health.max&!talent.weapons_of_order.enabled&!dot.aspect_of_harmony_damage.ticking
actions.mitigation+=/celestial_infusion,if=(!settings.combo_max_damage|buff.blackout_combo.down)&fight_remains<20&fight_remains>14&buff.aspect_of_harmony_accumulator.value>0.2*health.max
actions.mitigation+=/celestial_infusion,if=(!settings.combo_max_damage|buff.blackout_combo.down)&buff.aspect_of_harmony_accumulator.value>0.3*health.max&cooldown.weapons_of_order.remains>20&!dot.aspect_of_harmony_damage.ticking
actions.mitigation+=/celestial_brew,if=(!settings.combo_max_damage|buff.blackout_combo.down)&buff.aspect_of_harmony_accumulator.value>0.3*health.max&buff.weapons_of_order.up&!dot.aspect_of_harmony_damage.ticking
actions.mitigation+=/celestial_brew,if=(!settings.combo_max_damage|buff.blackout_combo.down)&buff.aspect_of_harmony_accumulator.value>0.3*health.max&!talent.weapons_of_order.enabled&!dot.aspect_of_harmony_damage.ticking
actions.mitigation+=/celestial_brew,if=(!settings.combo_max_damage|buff.blackout_combo.down)&fight_remains<20&fight_remains>14&buff.aspect_of_harmony_accumulator.value>0.2*health.max
actions.mitigation+=/celestial_brew,if=(!settings.combo_max_damage|buff.blackout_combo.down)&buff.aspect_of_harmony_accumulator.value>0.3*health.max&cooldown.weapons_of_order.remains>20&!dot.aspect_of_harmony_damage.ticking

