actions.aoe+=/avengers_shield,if=!target_incombat
actions.aoe+=/consecration,if=buff.divine_guidance.stack=5&buff.shield_of_the_righteous.up
actions.aoe+=/blessed_hammer,if=set_bonus.tww3>=2&buff.blessed_assurance.up&buff.shield_of_the_righteous.up
actions.aoe+=/shield_of_the_righteous,if=buff.shield_of_the_righteous.remains<2|holy_power>3|buff.divine_purpose.up
actions.aoe+=/avengers_shield,if=time<10&fight_remains>10&buff.shield_of_the_righteous.up&(target.distance<13|solo)
actions.aoe+=/judgment,if=(charges>=2|full_recharge_time<=gcd.max|talent.hammer_and_anvil)&(target.distance<13|solo)
actions.aoe+=/avengers_shield,if=buff.moment_of_glory.up&buff.shining_light_full.up&buff.shield_of_the_righteous.up&(target.distance<13|solo)
actions.aoe+=/hammer_of_light,if=time>5&(buff.blessing_of_dawn.up|fight_remains<2)&(debuff.judgment.up|buff.hammer_of_light_ready.remains<2|buff.hammer_of_light_ready.stack>1|buff.hammer_of_light_free.up|(cooldown.eye_of_tyr.remains<3))
actions.aoe+=/eye_of_tyr,if=time>8&talent.lights_guidance.enabled
actions.aoe+=/blessed_hammer,if=set_bonus.tww3>=2&talent.hammer_and_anvil.enabled
actions.aoe+=/avengers_shield,if=!buff.bulwark_of_righteous_fury.up&talent.bulwark_of_righteous_fury.enabled&spell_targets.shield_of_the_righteous>=3&buff.barricade_of_faith.down&(target.distance<13|solo)
actions.aoe+=/hammer_of_the_righteous,if=buff.blessed_assurance.up&spell_targets.shield_of_the_righteous<3&!buff.avenging_wrath.up
actions.aoe+=/blessed_hammer,if=buff.blessed_assurance.up&spell_targets.shield_of_the_righteous<3
actions.aoe+=/crusader_strike,if=buff.blessed_assurance.up&spell_targets.shield_of_the_righteous<2&!buff.avenging_wrath.up
actions.aoe+=/hammer_of_wrath,if=target.distance<13|solo
actions.aoe+=/judgment,cycle_targets=1,if=buff.avenging_wrath.up&talent.hammer_and_anvil.enabled&(target.distance<13|solo)
actions.aoe+=/judgment,cycle_targets=1,if=target.distance<13|solo
actions.aoe+=/hammer_of_the_righteous,if=(buff.blessed_assurance.up&spell_targets.shield_of_the_righteous<3)|buff.shake_the_heavens.up
actions.aoe+=/blessed_hammer,if=(buff.blessed_assurance.up&spell_targets.shield_of_the_righteous<3)|buff.shake_the_heavens.up
actions.aoe+=/crusader_strike,if=(buff.blessed_assurance.up&spell_targets.shield_of_the_righteous<2)|buff.shake_the_heavens.up
actions.aoe+=/eye_of_tyr,if=time>8&talent.lights_guidance.enabled&(talent.inmost_light.enabled&raid_event.adds.in>=45|spell_targets.shield_of_the_righteous>=3)&!talent.lights_deliverance.enabled
actions.aoe+=/blessed_hammer
actions.aoe+=/hammer_of_the_righteous
actions.aoe+=/crusader_strike
actions.aoe+=/eye_of_tyr,if=time>8&talent.lights_guidance.enabled&!talent.lights_deliverance.enabled
actions.aoe+=/arcane_torrent,if=holy_power<5
actions.aoe+=/consecration

actions.trinkets+=/chaotic_nethergate,enabled=0,if=active_enemies>=5&fight_remains>20&time>5&!moving
actions.trinkets+=/use_item,name=soulbinders_embrace,if=health.pct<=70
actions.trinkets+=/use_item,name=tome_of_lights_devotion,if=buff.inner_resilience.up
actions.trinkets+=/use_item,name=unyielding_netherprism,if=buff.avenging_wrath.remains>15
# self
actions.trinkets+=/use_items,slots=trinket1,if=!trinket.1.is.soulbinders_embrace&(variable.trinket_sync_slot=1&(buff.avenging_wrath.up)|(variable.trinket_sync_slot=2&(!trinket.2.cooldown.ready|!buff.avenging_wrath.up))|!variable.trinket_sync_slot)
actions.trinkets+=/use_items,slots=trinket2,if=!trinket.1.is.soulbinders_embrace&(variable.trinket_sync_slot=2&(buff.avenging_wrath.up)|(variable.trinket_sync_slot=1&(!trinket.1.cooldown.ready|!buff.avenging_wrath.up))|!variable.trinket_sync_slot)

