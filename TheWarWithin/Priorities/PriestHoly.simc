actions.precombat+=/power_word_fortitude
actions.precombat+=/angelic_feather,if=(!buff.body_and_soul.up|!talent.body_and_soul)&!buff.angelic_feather.up&charges>2&movement.distance>8&!buff.premonition_of_insight.up
actions.precombat+=/power_word_shield,if=(!buff.body_and_soul.up&talent.body_and_soul)&!buff.angelic_feather.up&movement.distance>8&!buff.premonition_of_insight.up

actions+=/purify,if=!raid
actions+=/dispel_magic,if=!raid
actions+=/angelic_feather,if=(!buff.body_and_soul.up|!talent.body_and_soul)&!buff.angelic_feather.up&charges>2&movement.distance>8&!buff.premonition_of_insight.up
actions+=/call_action_list,name=cooldowns
actions+=/desperate_prayer,if=health.pct<50
actions+=/call_action_list,name=health_aoe_cd,if=health_party_pct<100&((!raid&(find.hurt_num.count>1|find.hurt_num_big.count>1))|(raid&(find.hurt_num.count>2|find.hurt_num_big.count>2)))
actions+=/call_action_list,name=health_aoe,if=health_party_pct<100&((!raid&(find.hurt_num.count>1|find.hurt_num_big.count>1))|(raid&(find.hurt_num.count>2|find.hurt_num_big.count>2)))
actions+=/call_action_list,name=health_st
actions+=/holy_fire,cycle_targets=1,if=!moving&(talent.empyreal_blaze|talent.harmonious_apparatus|!ticking|refreshable)&!(buff.empyreal_blaze.up&(cooldown.divine_word.up|buff.divine_word.up)&cooldown.holy_word_chastise.up)
actions+=/shadow_word_pain,if=(refreshable|!ticking)&(target.time_to_die>=dot.shadow_word_pain.duration)&!buff.divine_favor_chastise.up&!buff.apotheosis.up
actions+=/call_action_list,name=divine_favor_chastise_prep,if=talent.divine_word&talent.holy_word_chastise&buff.divine_favor_chastise.down
actions+=/run_action_list,name=divine_favor_chastise_active,strict=1,if=buff.divine_favor_chastise.up
actions+=/run_action_list,name=divine_favor_filler,if=talent.divine_word&talent.holy_word_chastise&buff.divine_favor_chastise.down
actions+=/run_action_list,name=divine_image,strict=1,if=talent.divine_image
actions+=/run_action_list,name=generic

actions.divine_favor_chastise_prep+=/variable,name=empyreal_exec_time,op=set,value=0
actions.divine_favor_chastise_prep+=/variable,name=apotheosis_exec_time,op=setif,condition=talent.apotheosis,value=action.apotheosis.execute_time,value_else=0
actions.divine_favor_chastise_prep+=/apotheosis,if=(cooldown.holy_word_chastise.remains>cooldown.divine_word.remains)&(cooldown.divine_word.remains<=(variable.empyreal_exec_time+variable.apotheosis_exec_time))&health_party_pct<50
actions.divine_favor_chastise_prep+=/divine_word,if=cooldown.holy_word_chastise.up&(!talent.empyreal_blaze|buff.empyreal_blaze.up)&health_party_pct<50
actions.divine_favor_chastise_prep+=/holy_word_chastise,if=!talent.empyreal_blaze&buff.divine_word.up|talent.empyreal_blaze&buff.empyreal_blaze.down

actions.divine_favor_chastise_active+=/halo,if=spell_targets.halo>=2&health_party_pct<50
actions.divine_favor_chastise_active+=/divine_star,if=spell_targets.divine_star>=2&health_party_pct<50
actions.divine_favor_chastise_active+=/holy_nova,if=(spell_targets.holy_nova>=2&buff.rhapsody.stack>=18)|(spell_targets.holy_nova>=3&buff.rhapsody.stack>=9)|(spell_targets.holy_nova>=4&buff.rhapsody.stack>=4)|spell_targets.holy_nova>=5
actions.divine_favor_chastise_active+=/mindgames
actions.divine_favor_chastise_active+=/shadow_word_death,if=target.health.pct<20
actions.divine_favor_chastise_active+=/holy_word_chastise
actions.divine_favor_chastise_active+=/smite,cycle_targets=1,if=spell_targets.holy_nova>=2
actions.divine_favor_chastise_active+=/smite

actions.divine_favor_filler+=/halo,if=spell_targets.halo>=2&health_party_pct<50
actions.divine_favor_filler+=/divine_star,if=spell_targets.divine_star>=2&health_party_pct<50
actions.divine_favor_filler+=/holy_nova,if=(spell_targets.holy_nova>=2&buff.rhapsody.stack>=18)|(spell_targets.holy_nova>=3&buff.rhapsody.stack>=9)|(spell_targets.holy_nova>=4&buff.rhapsody.stack>=4)|spell_targets.holy_nova>=5
actions.divine_favor_filler+=/mindgames
actions.divine_favor_filler+=/shadow_word_death,if=target.health.pct<20
actions.divine_favor_filler+=/holy_word_chastise,if=(cooldown.apotheosis.remains<cooldown.divine_word.remains)|(cooldown.holy_word_chastise.duration_expected<=cooldown.divine_word.remains)
actions.divine_favor_filler+=/smite

actions.divine_image+=/apotheosis,if=buff.answered_prayers.down&!(cooldown.holy_word_sanctify.up|cooldown.holy_word_serenity.up|cooldown.holy_word_chastise.up)&find.lowest_hp.pct<50
actions.divine_image+=/holy_word_sanctify,line_cd=9,if=health_party_pct<50
actions.divine_image+=/holy_word_serenity,line_cd=9,if=find.lowest_hp.pct<50
actions.divine_image+=/holy_word_chastise
actions.divine_image+=/halo,if=spell_targets.halo>=2&health_party_pct<50
actions.divine_image+=/divine_star,if=spell_targets.divine_star>=2
actions.divine_image+=/holy_nova,if=(spell_targets.holy_nova>=2&buff.rhapsody.stack>=18)|(spell_targets.holy_nova>=3&buff.rhapsody.stack>=9)|(spell_targets.holy_nova>=4&buff.rhapsody.stack>=4)|spell_targets.holy_nova>=5
actions.divine_image+=/mindgames
actions.divine_image+=/shadow_word_death,if=target.health.pct<20
actions.divine_image+=/smite

actions.generic+=/holy_word_chastise
actions.generic+=/apotheosis,if=cooldown.holy_word_chastise.remains>(gcd.max*3)
actions.generic+=/halo,if=spell_targets.halo>=2
actions.generic+=/divine_star,if=spell_targets.divine_star>=2
actions.generic+=/holy_nova,if=(spell_targets.holy_nova>=2&buff.rhapsody.stack>=18)|(spell_targets.holy_nova>=3&buff.rhapsody.stack>=9)|(spell_targets.holy_nova>=4&buff.rhapsody.stack>=4)|spell_targets.holy_nova>=5
actions.generic+=/mindgames
actions.generic+=/shadow_word_death,if=target.health.pct<20
actions.generic+=/smite

actions.cooldowns+=/mindbender,if=mana.pct<80
actions.cooldowns+=/power_infusion,if=(!talent.divine_word|(cooldown.divine_word.up&cooldown.holy_word_chastise.up))
actions.cooldowns+=/potion,if=buff.power_infusion.up
actions.cooldowns+=/premonition_of_insight,if=find.lowest_hp.pct<70&talent.premonition.enabled
actions.cooldowns+=/premonition_of_piety,if=find.lowest_hp.pct<70&talent.premonition.enabled
actions.cooldowns+=/premonition_of_solace,if=find.lowest_hp.pct<70&talent.premonition.enabled
actions.cooldowns+=/premonition_of_clairvoyance,if=find.lowest_hp.pct<70&talent.premonition.enabled

actions.health_aoe_cd+=/gallagio_bottle_service,if=find.lowest_hp.pct<50
actions.health_aoe_cd+=/ringing_ritual_mud,if=health.pct<50
actions.health_aoe_cd+=/halo,if=(find.hurt_num_big.count>8&raid)|!raid
actions.health_aoe_cd+=/divine_word,if=talent.divine_word.enabled
actions.health_aoe_cd+=/lightwell
actions.health_aoe_cd+=/prayer_of_healing,if=talent.prayer_of_healing.enabled&find.lowest_hp.pct<40

actions.health_aoe+=/apotheosis,if=cooldown.holy_word_chastise.remains>(gcd.max*3)&cooldown.holy_word_sanctify.full_recharge_time>45
actions.health_aoe+=/prayer_of_mending,if=find.tank.exist
actions.health_aoe+=/holy_word_sanctify
actions.health_aoe+=/circle_of_healing,if=talent.circle_of_healing.enabled
actions.health_aoe+=/holy_nova,if=buff.rhapsody.stack>15&health_party_pct<95
actions.health_aoe+=/divine_star


actions.health_st+=/guardian_spirit,if=find.lowest_hp.pct<40 
actions.health_st+=/apotheosis,if=cooldown.holy_word_chastise.remains>(gcd.max*3)&cooldown.holy_word_sanctify.full_recharge_time>45
actions.health_st+=/holy_word_serenity,if=find.lowest_hp.pct<70
actions.health_st+=/power_word_life,if=find.lowest_hp.pct<35
actions.health_st+=/flash_heal,if=buff.surge_of_light.up&find.lowest_hp.pct<95
actions.health_st+=/prayer_of_mending,if=find.tank.exist
actions.health_st+=/renew,if=target.health.pct<=100&target.health.pct>=80&!raid&target.is_friendly
actions.health_st+=/flash_heal,if=buff.lightweaver.down&mana.pct>20&find.lowest_hp.pct<80
actions.health_st+=/heal,if=buff.lightweaver.up&find.lowest_hp.pct<90
