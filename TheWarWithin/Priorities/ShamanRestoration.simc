actions.precombat+=/earthliving_weapon,if=buff.earthliving_weapon.down
actions.precombat+=/skyfury,if=buff.skyfury.down|active_dot.skyfury<group_members
actions.precombat+=/water_shield,if=buff.water_shield.down
actions.precombat+=/flametongue_weapon,if=buff.earthliving_weapon.down&buff.earthliving_weapon.down
actions.precombat+=/earth_shield,line_cd=5,if=find.tank.exist
actions.precombat+=/earth_shield,line_cd=5,if=buff.earth_shield.down&talent.elemental_orbit.enabled&find.health.pct<=100&group_members>1
actions.precombat+=/tidecallers_guard
actions.precombat=/cleanse_spirit
actions.precombat+=/riptide,if=find.lowest_hp.pct<85


actions.default+=/wind_shear
actions.default+=/call_action_list,name=mitigation,strict=1,if=!Pvepvp_check&!raid
actions.default+=/earthen_wall_totem,if=(active_enemies>4|boss)&!moving
actions.default+=/earth_shield,line_cd=5,if=find.tank.exist&find.none_target_lowest_hp.pct>70
actions.default+=/earth_shield,line_cd=5,if=buff.earth_shield.down&talent.elemental_orbit.enabled&find.health.pct<=100&find.none_target_lowest_hp.pct>80
actions.default+=/call_action_list,name=racial
actions.default+=/totemic_projection,enabled=0,if=totem.surging_totem.remains>2&!moving
actions.default+=/use_items,enabled=0
actions.default+=/surging_totem,if=(active_enemies>2|boss)&mana.pct>20&talent.surging_totem.enabled&talent.acid_rain.enabled&!moving
actions.default+=/totemic_recall,if=cooldown.healing_stream_totem.remains>10
actions.default+=/healing_stream_totem,if=talent.healing_stream_totem_2.rank=1&charges_fractional>=2&!raid
actions.default+=/healing_rain,if=(!moving&find.none_target_lowest_hp.pct>80&(active_enemies>4|boss)&mana.pct>90&!raid&!talent.surging_totem.enabled&talent.acid_rain.enabled)|buff.ancestral_swiftness.up
actions.default+=/unleash_life,if=talent.ancestral_swiftness.enabled&find.lowest_hp.pct<=100
actions.default+=/unleash_life,if=find.lowest_hp.pct<50&!talent.ancestral_swiftness.enabled
actions.default+=/ancestral_swiftness,if=talent.ancestral_swiftness.enabled
actions.default+=/lava_burst,if=buff.lava_surge.up&target_is_enemie&find.none_target_lowest_hp.pct>50
actions.default+=/flame_shock,if=target_is_enemie&moving&target.debuff.flame_shock.down&find.none_target_lowest_hp.pct=100&mana.pct>20&buff.spiritwalkers_grace.down
actions.default+=/frost_shock,if=target_is_enemie&moving&target.debuff.frost_shock.down&find.none_target_lowest_hp.pct=100&mana.pct>20&buff.spiritwalkers_grace.down
actions.default+=/spiritwalkers_grace,if=buff.ascendance.remains>10
actions.default+=/call_action_list,name=cds
actions.default+=/call_action_list,name=health_aoe,if=find.none_target_lowest_hp.pct<100&(((!raid&find.hurt_num_big.count>1)|(raid&find.hurt_num_big.count>2))|((!raid&find.hurt_num.count>1)|(raid&find.hurt_num.count>2)))
actions.default+=/call_action_list,name=health_st,if=find.none_target_lowest_hp.pct<100
actions.default+=/flame_shock,if=target.debuff.flame_shock.down&mana.pct>20&target_is_enemie
actions.default+=/chain_lightning,if=active_enemies>1&!moving
actions.default+=/lava_burst,if=target.debuff.flame_shock.up&mana.pct>20&!moving
actions.default+=/primal_strike,if=target.distance<3&moving&mana.pct>20
actions.default+=/lightning_bolt

actions.cds+=/chromebustible_bomb_suit,if=health.pct<50
actions.cds+=/ringing_ritual_mud,if=health.pct<50
actions.cds+=/gallagio_bottle_service,if=find.none_target_lowest_hp.pct<70|(((!raid&find.hurt_num_big.count>1)|(raid&find.hurt_num_big.count>2))|((!raid&find.hurt_num.count>1)|(raid&find.hurt_num_big.count>2)))

actions.health_aoe+=/cloudburst_totem,if=totem.cloudburst_totem.down&talent.cloudburst_totem.rank>=1
actions.health_aoe+=/wellspring,if=talent.wellspring.enabled&buff.unleash_life.up
actions.health_aoe+=/surging_totem,if=find.none_target_lowest_hp.pct<80&talent.surging_totem.enabled&!moving&!moving
actions.health_aoe+=/ascendance,if=find.none_target_lowest_hp.pct<45|health.pct<45
actions.health_aoe+=/healing_rain,if=mana.pct>30&!talent.surging_totem.enabled&buff.call_of_the_ancestors.up
actions.health_aoe+=/wellspring,if=talent.wellspring.enabled&((raid&find.hurt_num_big.count>4)|(!raid&find.hurt_num_big.count>2))&find.none_target_lowest_hp.pct<70&!moving
actions.health_aoe+=/natures_swiftness,if=find.none_target_lowest_hp.pct<60
actions.health_aoe+=/chain_heal,if=buff.natures_swiftness.up|buff.ancestral_swiftness.up&find.lowest_hp.pct<100
#actions.health_aoe+=/healing_wave,if=active_hot.riptide>2&buff.tidal_waves.up&buff.primordial_wave.up&find.lowest_hp.pct<100
actions.health_aoe+=/healing_surge,if=buff.ascendance.up&buff.tidal_waves.up&find.lowest_hp.pct<100&!raid
actions.health_aoe+=/riptide,if=buff.ascendance.up&find.lowest_hp.pct<100
actions.health_aoe+=/healing_stream_totem,if=find.none_target_lowest_hp.pct<80&!talent.ancestral_swiftness.enabled
actions.health_aoe+=/healing_tide_totem,if=((raid&find.hurt_num_big.count>5)|(!raid&find.hurt_num_big.count>2))&find.none_target_lowest_hp.pct<50&!raid&buff.ascendance.down
actions.health_aoe+=/chain_heal,if=buff.high_tide.up&buff.tidebringer.up&find.lowest_hp.pct<85&((raid&find.hurt_num_big.count>4)|(!raid&find.hurt_num_big.count>2))&mana.pct>10
actions.health_aoe+=/chain_heal,if=buff.tidebringer.up&find.lowest_hp.pct<80&((raid&find.lowest_hp.pct>2)|(!raid&find.lowest_hp.pct>1))&((mana.pct>80&!raid)|(mana.pct>40&raid))
actions.health_aoe+=/downpour,if=mana.pct>40
actions.health_aoe+=/healing_rain,if=find.none_target_lowest_hp.pct>50&find.none_target_lowest_hp.pct<708&mana.pct>75&!talent.surging_totem.enabled
actions.health_aoe+=/chain_heal,if=find.lowest_hp.pct<70&mana.pct>5

# actions.health_st+=/healing_wave,if=find.lowest_hp.pct<90&find.lowest_hp.pct>70&mana.pct>70&buff.tidal_waves.up&(!moving|buff.spiritwalkers_grace.up)
actions.health_st+=/healing_stream_totem,if=find.none_target_lowest_hp.pct>80&talent.ancestral_swiftness.enabled
actions.health_st+=/riptide,if=find.lowest_hp.pct<85|buff.tidal_waves.down
actions.health_st+=/primordial_wave,if=find.none_target_lowest_hp.pct<60&find.none_target_lowest_hp.pct<100
actions.health_st+=/healing_surge,if=buff.tidal_waves.up&((find.lowest_hp.pct<40&raid&mana.pct>65)|(find.lowest_hp.pct<80&!raid))&(!moving|buff.spiritwalkers_grace.up)

actions.racial+=/blood_fury
actions.racial+=/bag_of_tricks
actions.racial+=/ancestral_call
actions.racial+=/berserking

actions.mitigation=/cleanse_spirit
actions.mitigation+=/purge,line_cd=settings.purge_icd,if=buff.dispellable_magic.up
actions.mitigation+=/greater_purge,if=buff.dispellable_magic.up
actions.mitigation+=/earth_elemental,if=health.pct<hp_gap&buff.astral_shift.down&buff.stone_bulwark.down&buff.earth_elemental.down&(range_spell_magic|target_me_spell_magic|dot_spell_magic|range_spell_physic|target_me_spell_physic|dot_spell_physic)
actions.mitigation+=/stone_bulwark_totem,if=health.pct<hp_gap&buff.astral_shift.down&buff.stone_bulwark.down&buff.earth_elemental.down&(range_spell_magic|target_me_spell_magic|dot_spell_magic|range_spell_physic|target_me_spell_physic|dot_spell_physic)
actions.mitigation+=/astral_shift,if=health.pct<hp_gap&buff.astral_shift.down&buff.stone_bulwark.down&buff.earth_elemental.down&(range_spell_magic|target_me_spell_magic|dot_spell_magic|range_spell_physic|target_me_spell_physic|dot_spell_physic)