actions.precombat+=/mark_of_the_wild,if=buff.mark_of_the_wild.down
#actions.precombat+=/symbiotic_relationship,if=buff.symbiotic_relationship.down&find.tank.token
actions.precombat+=/natures_cure
actions.precombat+=/rejuvenation,if=find.lowest_hp.pct<=90
actions.precombat+=/wild_growth,enable_moving=true,moving=0,if=find.hurt_num.count>2

actions.default+=/call_action_list,name=bear,strict=1,if=buff.bear_form.up
actions.default+=/skull_bash,if=target.distance<=5&!moving
actions.default+=/rebirth
actions.default+=/call_action_list,name=mitigation,strict=1,if=!Pvepvp_check&!raid
#actions.default+=/moonkin_form,if=buff.moonkin_form.up&find.none_target_lowest_hp.pct<70
actions.default+=/call_action_list,name=cds,if=find.lowest_hp.pct<100&((!raid&find.hurt_num_big.count>1)|(raid&find.hurt_num_big.count>3))
actions.default+=/overgrowth,if=find.lowest_hp.pct<45
actions.default+=/ironbark,if=find.lowest_hp.pct<30
actions.default+=/use_items,enabled=0
actions.default+=/berserking
actions.default+=/adaptive_swarm,if=talent.adaptive_swarm.enabled
actions.default+=/call_action_list,name=raid,if=raid
actions.default+=/lifebloom,if=!raid&find.health.pct<=100&find.health.pct>30&(active_hot.lifebloom<2&talent.undergrowth|!talent.undergrowth&active_hot.lifebloom<1)
actions.default+=/lifebloom,if=!raid&talent.undergrowth.enabled&buff.cat_form.down&find.lowest_hp.role!=find.tank.token&(active_hot.lifebloom<2&talent.undergrowth|!talent.undergrowth&active_hot.lifebloom<1)&find.lowest_hp.pct>30
actions.default+=/rejuvenation,if=(!rejuvenation_forbidden&find.random_unit.unit&(active_hot.rejuvenation<=5&!raid|active_hot.rejuvenation<=settings.raid_rejuvenation_num&raid)&find.none_target_lowest_hp.pct>40)
actions.default+=/efflorescence,if=buff.efflorescence.down&buff.cat_form.down&buff.moonkin_form.down&find.none_target_lowest_hp.pct>70&!moving
actions.default+=/innervate,if=mana.pct<30&find.health.pct<100
actions.default+=/wild_growth,enable_moving=true,moving=0,if=(healer_spell_magic|find.none_target_lowest_hp<=95)&buff.wild_growth.remains<2
actions.default+=/call_action_list,name=health_aoe,if=((!raid&find.hurt_num.count>2)|(raid&find.hurt_num.count>3))
actions.default+=/call_action_list,name=health_st
actions.default+=/call_action_list,name=cat,if=target_is_enemie&target.distance<=5&!combat_forbidden&hero_tree.wildstalker
actions.default+=/call_action_list,name=cat_out,if=target_is_enemie&(target.distance>=10|raid)&!combat_forbidden&hero_tree.wildstalker
actions.default+=/call_action_list,name=st,if=target_is_enemie&health_party_pct>95&!combat_forbidden&!hero_tree.wildstalker


actions.raid+=/lifebloom,if=find.tank.exist&(active_hot.lifebloom<2&talent.undergrowth|!talent.undergrowth&active_hot.lifebloom<1)
actions.raid+=/lifebloom,if=find.lowest_hp.pct<=100&(active_hot.lifebloom<2&talent.undergrowth|!talent.undergrowth&active_hot.lifebloom<1)

actions.health_aoe+=/wild_growth,enable_moving=true,moving=0,if=buff.wild_growth.remains<2
actions.health_aoe+=/swiftmend,if=find.lowest_hp.pct<=60
actions.health_aoe+=/invigorate

actions.health_st+=/rejuvenation,if=(!rejuvenation_forbidden&find.lowest_hp.pct<=100&(active_hot.rejuvenation<=5&!raid&target.distance>7|active_hot.rejuvenation<=settings.raid_rejuvenation_num&raid)&find.lowest_hp.pct>40)&moving
actions.health_st+=/grove_guardians,if=find.lowest_hp.pct<60&charges=1|charges=2&find.lowest_hp.pct<70|charges=3
actions.health_st+=/regrowth,if=(buff.clearcasting.up|buff.blooming_infusion_regrowth.up)&find.lowest_hp.pct<80&(!moving|buff.natures_swiftness.up|buff.blooming_infusion_regrowth.up)
actions.health_st+=/swiftmend,if=find.lowest_hp.pct<=60
actions.health_st+=/nourish,enable_moving=true,moving=0,if=buff.wild_synthesis.stack>2
actions.health_st+=/gallagio_bottle_service,if=find.none_target_lowest_hp.pct<50
actions.health_st+=/cenarion_ward,if=find.lowest_hp.pct<80
actions.health_st+=/regrowth,enable_moving=true,moving=0,if=find.lowest_hp.pct<70


actions.cds+=/innervate,if=mana.pct<40&health_party_pct<=75
actions.cds+=/chromebustible_bomb_suit,if=health.pct<=50
actions.cds+=/ringing_ritual_mud,if=health.pct<50
actions.cds+=/grove_guardians,if=find.lowest_hp.pct<60&charges=1|charges=2&find.lowest_hp.pct<70|charges=3
actions.cds+=/natures_swiftness,line_cd=5,if=health_party_pct<=convoke_the_spirit_health&buff.incarnation_tree_of_life.down&cooldown.convoke_the_spirits.ready&!prev.1.natures_swiftness&!prev.1.convoke_the_spirits
actions.cds+=/convoke_the_spirits,if=(health_party_pct<=convoke_the_spirit_health|find.lowest_hp.pct<=30)&buff.incarnation_tree_of_life.down&prev.1.natures_swiftness
actions.cds+=/flourish,if=active_hot.rejuvenatio>2&active_hot.wild_growth>2&health_party_pct<flourish_health&buff.incarnation_tree_of_life.down
actions.cds+=/gallagio_bottle_service,if=find.none_target_lowest_hp.pct<70
actions.cds+=/incarnation_tree_of_life,if=buff.incarnation_tree_of_life.down&health_party_pct<=incarnation_tree_of_life_health&!prev.1.convoke_the_spirits
actions.cds+=/tranquility,enable_moving=true,moving=0,if=health_party_pct<tranquility_health&((!raid&find.hurt_num_big.count>3)|(raid&find.hurt_num_big.count>8))&buff.incarnation_tree_of_life.down&!prev.1.convoke_the_spirits

actions.st+=/cat_form,if=buff.cat_form.up
actions.st+=/moonkin_form,enabled=0,if=buff.moonkin_form.down&health_party_pct>=100
actions.st+=/sunfire,cycle_targets=1,max_cycle_targets=5,if=target.debuff.sunfire.down&buff.cat_form.down&mana.pct>20
actions.st+=/moonfire,cycle_targets=1,max_cycle_targets=5,if=moving
actions.st+=/moonfire,cycle_targets=1,max_cycle_targets=5,if=target.debuff.moonfire.down&buff.cat_form.down&mana.pct>20
actions.st+=/starfire,if=target_is_enemie&buff.blooming_infusion.up
actions.st+=/starsurge,if=buff.cat_form.down&mana.pct>20
actions.st+=/starfire,enable_moving=true,moving=0,if=active_enemies>2&buff.cat_form.down&mana.pct>20
actions.st+=/wrath,enable_moving=true,moving=0,if=buff.cat_form.down&mana.pct>20

actions.cat+=/heart_of_the_wild
#actions.cat+=/cat_form,if=buff.cat_form.down&!talent.fluid_form.enabled
actions.cat+=/rip,if=target.debuff.rip.down&combo_points=5
actions.cat+=/ferocious_bite,max_energy=0,if=combo_points=5
actions.cat+=/rake,if=target.debuff.rake.down
actions.cat+=/thrash_cat,if=target.debuff.thrash_cat.down
actions.cat+=/swipe_cat,enabled=0,if=active_enemies>2
actions.cat+=/shred


actions.cat_out+=/sunfire,cycle_targets=1,max_cycle_targets=5,if=target.debuff.sunfire.down&buff.cat_form.down
actions.cat_out+=/moonfire,cycle_targets=1,max_cycle_targets=5,if=target.debuff.moonfire.down&buff.cat_form.down
actions.cat_out+=/starsurge
actions.cat_out+=/starfire,if=find.none_target_lowest_hp.pct>80
actions.cat_out+=/wrath,if=health_party_pct>95&buff.cat_form.down



actions.mitigation+=/soothe
actions.mitigation+=/natures_cure
actions.mitigation+=/natures_vigil,if=health.pct<90
actions.mitigation+=/renewal,if=health.pct<=40
actions.mitigation+=/natures_swiftness,line_cd=5,if=cooldown.natures_swiftness.charges>1&find.health.pct<=40&!prev.1.natures_swiftness
actions.mitigation+=/regrowth,if=buff.natures_swiftness.up&find.health.pct<=40
actions.mitigation+=/barkskin,if=health.pct<30
actions.mitigation+=/barkskin,if=health.pct<=hp_gap&buff.barkskin.down&buff.ironbark.down&(range_spell_magic|target_me_spell_magic|dot_spell_magic|range_spell_physic|target_me_spell_physic|dot_spell_physic)
actions.mitigation+=/ironbark,if=health.pct<=hp_gap&buff.barkskin.down&buff.ironbark.down&(range_spell_magic|target_me_spell_magic|dot_spell_magic|range_spell_physic|target_me_spell_physic|dot_spell_physic)

actions.bear=/frenzied_regeneration,if=health.pct<=hp_gap&buff.bear_form.up
actions.bear+=/bear_wait
