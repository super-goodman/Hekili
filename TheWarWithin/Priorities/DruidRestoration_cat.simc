actions.precombat+=/mark_of_the_wild,if=buff.mark_of_the_wild.down
actions.precombat+=/lifebloom,if=active_hot.lifebloom<2&find.health.pct<100
actions.precombat+=/lifebloom,if=talent.undergrowth.enabled&buff.cat_form.down&find.lowest_hp.role!=find.tank.token&active_hot.lifebloom<2&find.health.pct<100
actions.precombat+=/cat_form,line_cd=2,if=find.none_target_lowest_hp.pct>75&buff.cat_form.down
actions.precombat+=/prowl,if=buff.cat_form.up&buff.prowl_base.down
actions.precombat+=/shred,enabled=0
actions.precombat+=/rake,enabled=0

actions.default+=/soothe
actions.default+=/natures_cure
actions.default+=/skull_bash
actions.default+=/overgrowth,if=find.lowest_hp.pct<35
actions.default+=/natures_vigil,if=find.hurt_num_big.count>2&find.lowest_hp.pct<75
actions.default+=/innervate,if=find.hurt_num_big.count>2&find.none_target_lowest_hp.pct<75|mana.pct<60
actions.default+=/ironbark,if=find.lowest_hp.pct<40&(find.hurt_num_big.count>1|find.hurt_num.count>1)
actions.default+=/barkskin,if=health.pct<60&(find.hurt_num_big.count>1|find.hurt_num.count>1)
actions.default+=/use_items,if=!trinket.t2.is.gallagio_bottle_service&!trinket.t1.is.gallagio_bottle_service
actions.default+=/renewal,if=health.pct<60
actions.default+=/berserking,if=target.health.current>=5*health.max
actions.default+=/efflorescence,if=buff.efflorescence.down&buff.cat_form.down&buff.moonkin_form.down
actions.default+=/natures_swiftness,if=find.lowest_hp.pct<65&buff.natures_swiftness.down
actions.default+=/swiftmend,if=find.lowest_hp.pct<80
actions.default+=/regrowth,if=active_hot.lifebloom=2&find.lowest_hp.pct<=75&!moving&active_hot.regrowth<2
actions.default+=/wild_growth,if=(find.hurt_num_big.count>2|find.hurt_num.count>2)&!moving
actions.default+=/rejuvenation,if=buff.cat_form.down&find.lowest_hp.pct<98&(active_hot.rejuvenation<=5&!raid|active_hot.rejuvenation<=raid_rejuvenation_num&raid)
actions.default+=/lifebloom,,if=buff.cat_form.down&talent.undergrowth.enabled&find.lowest_hp.role!=find.tank.token&active_hot.lifebloom<2
actions.default+=/grove_guardians,if=find.lowest_hp.pct<50&charges=1|charges=2&find.lowest_hp.pct<60|charges=3
actions.default+=/tranquility,if=find.none_target_lowest_hp.pct<70&find.hurt_num_big.count>3&!moving
actions.default+=/convoke_the_spirits,if=(buff.cat_form.down|buff.cat_form.up&buff.heart_of_the_wild.up)&(find.hurt_num_big.count>2|find.hurt_num.count>2)&find.none_target_lowest_hp.pct<80|buff.cat_form.up&(find.hurt_num_big.count>2|find.hurt_num.count>2)&find.none_target_lowest_hp.pct<90&(target.health.current>=3*health.max|active_enemies>3)
actions.default+=/regrowth,if=find.lowest_hp.pct<80&!moving
actions.default+=/rake,if=find.none_target_lowest_hp.pct>75&target.distance<5&target.debuff.rake.remains=0
actions.default+=/cat_form,line_cd=2,if=find.none_target_lowest_hp.pct>75&target.distance<5&buff.cat_form.down
actions.default+=/heart_of_the_wild,if=buff.cat_form.up
actions.default+=/shred,if=buff.cat_form.up&buff.prowl_base.up&target.distance<5&combo_points<5
actions.default+=/lunar_inspiration,if=buff.prowl_base.down&target.debuff.moonfire.remains=0&target.health.current>=3*health.max
actions.default+=/rip,if=target.distance<5&target.debuff.rip.down&combo_points=5&energy>25&target.health.current>=3*health.max
actions.default+=/ferocious_bite,if=target.debuff.bloodseeker_vines.up&target.distance<5&combo_points=5
actions.default+=/thrash_cat,if=target.distance<5&target.debuff.thrash_cat.down&buff.cat_form.up
actions.default+=/swipe_cat,if=active_enemies>3&target.distance<7&buff.cat_form.up
actions.default+=/shred,if=buff.cat_form.up&combo_points<5&target.distance<5
actions.default+=/moonfire,if=buff.prowl_base.down&target.distance>5&target.debuff.moonfire.remains=0&target.health.current>=3*health.max
actions.default+=/wrath,if=target_is_enemie&target.distance>10&target.distance<30
