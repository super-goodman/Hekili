actions.default+=/detox,if=
actions.default+=/spear_hand_strike,if=
actions.default+=/call_action_list,strict=1,list_name=mitigation,if=!Pvepvp_check&!raid
actions.default+=/potion,if=buff.aspect_of_harmony.up
actions.default+=/life_cocoon,use_while_casting=1,if=find.lowest_hp.pct<=life_cocoon_party_health&cooldown.life_cocoon.remains<=0
actions.default+=/ringing_ritual_mud,if=buff.invoke_chiji_the_red_crane.stack>=3&buff.enveloping_mist.downactions.default+=/call_action_list,name=ally,if=target.is_friendly,if=health.pct<50&!soothing_mist_casting
actions.default+=/swarmlords_authority_444301,if=health.pct<50&!soothing_mist_casting
actions.default+=/chromebustible_bomb_suit,if=health.pct<50&!soothing_mist_casting
actions.default+=/trinket1,enabled=0,slot=trinket1,if=
actions.default+=/trinket2,enabled=0,slot=trinket2,if=
actions.default+=/call_action_list,list_name=harmony,if=talent.aspect_of_harmony.enabled
actions.default+=/call_action_list,list_name=celestial,if=talent.celestial_conduit.enabled


actions.harmony+=/revival,if=incoming_party_damage_2s>health_party_max*0.3|health_party_pct<=50
actions.harmony+=/jadefire_stomp,if=buff.awakened_faeline.down|((buff.jadefire_teachings.down|buff.jadefire_teachings.remains<=2)&talent.jadefire_teachings.enabled)
actions.harmony+=/invoke_chiji_the_red_crane,if=(incoming_party_damage_2s>health_party_max*0.15|health_party_pct<=90)&cooldown_check
actions.harmony+=/celestial_conduit,if=(find.hurt_num.count>2|find.hurt_num_big.count>2)&health_party_pct<celestial_conduit_party_health&!prev_gcd.invoke_yulon_the_jade_serpent&!prev_gcd.sheiluns_gift
actions.harmony+=/sheiluns_gift,if=(incoming_party_damage_2s>health_party_max*0.15|gust_of_mist.count>=10|health_party_pct<=sheiluns_gift_party_health)&buff.aspect_of_harmony.down&fight_remains>5
actions.harmony+=/crackling_jade_lightning,if=(health_party_pct<=80&buff.jade_empowerment.stack>=1|buff.jade_empowerment.stack>=2)&!moving&buff.aspect_of_harmony.down&!prev.1.crackling_jade_lightning
actions.harmony+=/call_action_list,name=lei_tea,if=(incoming_party_damage_2s>health_party_max*0.1|health_party_pct<=80|totem.active&buff.aspect_of_harmony_accumulator.v1>health.max*0.5|buff.aspect_of_harmony_accumulator.v1>health.max*0.9|cooldown.thunder_focus_tea.charges=2&(time<8|buff.aspect_of_harmony_accumulator.v1<health.max*0.75))&fight_remains>15&cooldown.rising_sun_kick.ready|buff.aspect_of_harmony.up
actions.harmony+=/jadefire_stomp,if=buff.awakened_faeline.up&(buff.jadefire_teachings.down&talent.jadefire_teachings.enabled)
actions.harmony+=/rushing_wind_kick,if=talent.rushing_wind_kick.enabled
actions.harmony+=/expel_harm,if=health.pct<=75
actions.harmony+=/touch_of_death
actions.harmony+=/chi_burst,if=talent.chi_burst.enabled&!moving
actions.harmony+=/spinning_crane_kick,if=active_enemies>=5
actions.harmony+=/rising_sun_kick,if=
actions.harmony+=/vivify,if=buff.aspect_of_harmony_accumulator.v1<health.max*0.7&buff.vivacious_vivification.up&find.health.pct<=100
actions.harmony+=/blackout_kick,if=buff.teachings_of_the_monastery.stack>=2
actions.harmony+=/tiger_palm,if=buff.teachings_of_the_monastery.stack<2

actions.celestial+=/revival,if=incoming_party_damage_2s>health_party_max*0.3|health_party_pct<=50
actions.celestial+=/jadefire_stomp,if=buff.awakened_faeline.down|((buff.jadefire_teachings.down|buff.jadefire_teachings.remains<=2)&talent.jadefire_teachings.enabled)
actions.celestial+=/invoke_chiji_the_red_crane,if=(incoming_party_damage_2s>health_party_max*0.15|health_party_pct<=90)&cooldown_check
actions.celestial+=/celestial_conduit,if=(find.hurt_num.count>2|find.hurt_num_big.count>2)&health_party_pct<celestial_conduit_party_health&!prev_gcd.invoke_yulon_the_jade_serpent&!prev_gcd.sheiluns_gift
actions.celestial+=/sheiluns_gift,if=(incoming_party_damage_2s>health_party_max*0.15|gust_of_mist.count>=10|health_party_pct<=sheiluns_gift_party_health)&buff.aspect_of_harmony.down&fight_remains>5
actions.celestial+=/crackling_jade_lightning,if=(health_party_pct<=80&buff.jade_empowerment.stack>=1|buff.jade_empowerment.stack>=2)&!moving&buff.aspect_of_harmony.down&!prev.1.crackling_jade_lightning
actions.celestial+=/jadefire_stomp,if=buff.awakened_faeline.up&(buff.jadefire_teachings.down&talent.jadefire_teachings.enabled)
actions.celestial+=/rushing_wind_kick,if=talent.rushing_wind_kick.enabled
actions.celestial+=/expel_harm,if=health.pct<=75
actions.celestial+=/touch_of_death,if=
actions.celestial+=/chi_burst,if=talent.chi_burst.enabled&!moving
actions.celestial+=/spinning_crane_kick,if=active_enemies>=5
actions.celestial+=/rising_sun_kick,if=
actions.celestial+=/blackout_kick,if=buff.teachings_of_the_monastery.stack>=2
actions.celestial+=/tiger_palm,if=buff.teachings_of_the_monastery.stack<2

actions.lei_tea=/thunder_focus_tea,if=buff.aspect_of_harmony.down&fight_remains>10&cooldown.rising_sun_kick.ready
actions.lei_tea+=/rushing_wind_kick,if=talent.rushing_wind_kick.enabled
actions.lei_tea+=/rising_sun_kick
actions.lei_tea+=/crackling_jade_lightning,if=(incoming_party_damage_2s>health_party_max*0.2|health_party_pct<=65)&buff.jade_empowerment.up&!moving&!prev.1.crackling_jade_lightning
actions.lei_tea+=/expel_harm,if=health.pct<=75
actions.lei_tea+=/touch_of_death
actions.lei_tea+=/blackout_kick,if=buff.teachings_of_the_monastery.stack>=4
actions.lei_tea+=/chi_burst,if=talent.chi_burst.enabled&!moving
actions.lei_tea+=/tiger_palm,if=buff.teachings_of_the_monastery.stack<4


actions.ally+=/expel_harm,if=health.pct<=75
actions.ally+=/life_cocoon,if=target.health.pct<30
actions.ally+=/vivify,if=buff.vivacious_vivification.up&target.health.pct<=35
actions.ally+=/enveloping_mist,if=!moving
actions.ally+=/soothing_mist,if=buff.soothing_mist.down&!moving
actions.ally+=/vivify,if=buff.soothing_mist.up&!moving
actions.ally+=/renewing_mist


actions.mitigation+=/life_cocoon,use_while_casting=1,if=find.health.pct<=40
actions.mitigation+=/vivify,if=buff.vivacious_vivification.up&find.health.pct<=30
actions.mitigation+=/diffuse_magic,if=health.pct<=hp_gap&buff.touch_of_karma.down&buff.diffuse_magic.down&buff.fortifying_brew.down&(range_spell_magic|target_me_spell_magic|dot_spell_magic)
actions.mitigation+=/fortifying_brew,if=health.pct<=hp_gap&buff.touch_of_karma.down&buff.diffuse_magic.down&buff.fortifying_brew.down&(range_spell_magic|target_me_spell_magic|dot_spell_magic|range_spell_physic|target_me_spell_physic|dot_spell_physic)